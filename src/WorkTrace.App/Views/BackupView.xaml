<UserControl x:Class="WorkTrace.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WorkTrace.App.ViewModels"
             xmlns:controls="clr-namespace:WorkTrace.App.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             d:DataContext="{d:DesignInstance Type=vm:BackupViewModel}">
    <StackPanel>
      <!-- Automatic backups -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Automatic backups" Style="{StaticResource SectionTitleText}" />
          <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"
                     Text="While WorkTrace runs, it backs up on the schedule below, but only when something changed. A folder and email are separate destinations; use either or both." />
          <controls:SettingRow Header="Schedule">
            <ComboBox Width="160" ItemsSource="{Binding FrequencyOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectedValue="{Binding FrequencyKey}" AutomationProperties.Name="Backup schedule" />
          </controls:SettingRow>

          <Border Style="{StaticResource SettingsDivider}" />
          <controls:SettingRow Header="Back up to a folder"
                               Description="A complete backup (database, settings, board, guides, attachments) plus one file per creation month. Works with local, network and OneDrive folders.">
            <CheckBox IsChecked="{Binding FolderEnabled}" Content="On" AutomationProperties.Name="Back up to a folder" />
          </controls:SettingRow>
          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding Folder, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Backup folder" />
            <Button Grid.Column="1" Content="Browse…" Padding="12,5" Margin="8,0,0,0" Command="{Binding ChooseFolderCommand}" />
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE838;" Margin="4,0,0,0" ToolTip="Open the folder" Command="{Binding OpenFolderCommand}" />
          </Grid>
          <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Back up now" Padding="12,5" Command="{Binding BackupNowCommand}"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
            <CheckBox IsChecked="{Binding FolderIncludeScreenshots}" Content="Include automatic screenshots" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="{Binding FolderStatus}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0" />
          <TextBlock Text="{Binding FolderError}" Style="{StaticResource ErrorText}" />

          <Border Style="{StaticResource SettingsDivider}" />
          <controls:SettingRow Header="Send backups by email"
                               Description="The database backup and each changed creation month, as ZIP attachments (split into several emails when large). Sent with Resend: free, see the steps below.">
            <CheckBox IsChecked="{Binding EmailEnabled}" Content="On" AutomationProperties.Name="Send backups by email" />
          </controls:SettingRow>
          <TextBlock Text="Send to" Style="{StaticResource FieldLabelText}" />
          <TextBox Text="{Binding EmailTo, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Backup email address" />
          <TextBlock Text="Resend API key" Style="{StaticResource FieldLabelText}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="KeyBox" AutomationProperties.Name="Resend API key" />
            <Button Grid.Column="1" Content="Save key" Padding="12,5" Margin="8,0,0,0" Click="OnSaveKey" />
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="4,0,0,0" ToolTip="Remove the stored key"
                    Command="{Binding RemoveEmailKeyCommand}" Visibility="{Binding HasEmailKey, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
          <TextBlock Text="{Binding EmailKeyState}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None" />
          <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0"
                     Text="Setup: create a free account at resend.com with the address above, then API Keys › Create API Key with Sending access, and paste it here. The key is kept in Windows Credential Manager, never in WorkTrace's files or backups." />
          <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Send now" Padding="12,5" Command="{Binding SendNowCommand}"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
            <TextBlock Text="{Binding EmailStatus}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="{Binding EmailError}" Style="{StaticResource ErrorText}" />
        </StackPanel>
      </Border>

      <!-- Backup -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Manual backup" Style="{StaticResource SectionTitleText}" />
          <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"
                     Text="Saves a ZIP file you can keep anywhere (e.g. OneDrive or a USB stick). Cards are grouped by the month they were created. Each ZIP restores on its own." />
          <TextBlock Text="{Binding ChangedSummary}" Margin="0,8,0,0" />

          <WrapPanel Margin="0,12,0,0">
            <Button Style="{DynamicResource AccentButtonStyle}" Padding="14,6" Margin="0,0,8,8" Command="{Binding BackupCompleteCommand}"
                    ToolTip="All cards and screenshots, plus the database (time tracking) and settings">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE896;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                <TextBlock Text="Complete backup…" />
              </StackPanel>
            </Button>
            <Button Padding="14,6" Margin="0,0,8,8" Content="All cards…" Command="{Binding BackupAllCardsCommand}"
                    ToolTip="All cards and their screenshots" />
          </WrapPanel>

          <TextBlock Text="One month" Style="{StaticResource FieldLabelText}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MaxWidth="420" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" AutomationProperties.Name="Month">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MonthOptionViewModel}">
                  <StackPanel>
                    <TextBlock Text="{Binding Text}" />
                    <TextBlock Text="{Binding State}" Style="{StaticResource CaptionText}" FontSize="11" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Padding="14,6" Margin="8,0,0,0" Content="Back up month…" Command="{Binding BackupMonthCommand}" />
          </Grid>

          <Expander Header="Selected cards" Margin="0,12,0,0">
            <StackPanel Margin="0,6,0,0">
              <ListBox ItemsSource="{Binding Cards}" MaxHeight="220" Style="{StaticResource RowListBox}" AutomationProperties.Name="Cards to export">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:SelectableCardViewModel}">
                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Text}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Padding="14,6" Margin="0,8,0,0" HorizontalAlignment="Left" Content="Export selected…" Command="{Binding BackupSelectedCommand}" />
            </StackPanel>
          </Expander>

          <TextBlock Text="{Binding LastResult}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,10,0,0"
                     Visibility="{Binding LastResult, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>
      </Border>

      <!-- Restore -->
      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="Restore" Style="{StaticResource SectionTitleText}" />
          <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"
                     Text="Choose a WorkTrace backup ZIP, a browser-board backup, or the browser board's board.json. You see what would change before anything happens. Restoring never deletes cards, comments or screenshots." />
          <Button Padding="14,6" Margin="0,12,0,0" HorizontalAlignment="Left" Content="Choose file…" Command="{Binding ChooseRestoreFileCommand}" />

          <StackPanel Margin="0,12,0,0" Visibility="{Binding HasRestorePreview, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding RestoreSummary}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding RestoreProblems}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ListBox ItemsSource="{Binding RestoreItems}" MaxHeight="300" Margin="0,8,0,0" Style="{StaticResource RowListBox}"
                     AutomationProperties.Name="Restore preview">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:RestoreItemViewModel}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Key}" FontFamily="{StaticResource MonoFont}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding KindText}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <CheckBox Grid.Column="2" Content="Overwrite my edits" IsChecked="{Binding Overwrite}" Margin="12,0,0,0"
                              Visibility="{Binding CanOverwrite, Converter={StaticResource BoolToVisibility}}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Style="{DynamicResource AccentButtonStyle}" Padding="14,6" Content="Restore" Command="{Binding ApplyRestoreCommand}" />
              <Button Padding="14,6" Margin="8,0,0,0" Content="Cancel" Command="{Binding CancelRestoreCommand}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
</UserControl>
