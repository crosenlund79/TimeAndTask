<UserControl x:Class="WorkTrace.App.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WorkTrace.App.ViewModels"
             xmlns:views="clr-namespace:WorkTrace.App.Views"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             d:DataContext="{d:DesignInstance Type=vm:TasksViewModel}">

  <UserControl.InputBindings>
    <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NewTaskCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCommand}" />
  </UserControl.InputBindings>

  <UserControl.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Find" Executed="OnFind" />
  </UserControl.CommandBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel>
      <StackPanel>
        <TextBlock Text="Tasks" Style="{StaticResource PageTitleText}" />
        <TextBlock Style="{StaticResource PageSubtitleText}" Text="Reusable work items. Type a title, ticket number or stakeholder to find one." />

        <!-- Perspective quote: one at a time, a new one about every hour (or on request) -->
        <Border DataContext="{Binding Quote}" Margin="0,14,0,0" Padding="14,8,6,8" CornerRadius="4" HorizontalAlignment="Left" MaxWidth="780"
                Background="#F4F1E6" BorderBrush="#E2DCCB" BorderThickness="1" AutomationProperties.Name="Perspective">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#x201C;" FontFamily="Georgia" FontSize="30" Foreground="#8A9770" Margin="0,-7,10,-16" VerticalAlignment="Top"
                       IsHitTestVisible="False" />
            <TextBlock Grid.Column="1" Text="{Binding CurrentQuote}" TextWrapping="Wrap" VerticalAlignment="Center"
                       FontFamily="{DynamicResource TitleFontFamily}" FontStyle="Italic" FontSize="13.5" Foreground="#4A4438" />
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="11" Width="26" Height="26" Margin="10,0,0,0"
                    VerticalAlignment="Center" Opacity="0.75" Command="{Binding NextCommand}" ToolTip="Another thought"
                    AutomationProperties.Name="Show another quote" />
          </Grid>
        </Border>
      </StackPanel>
    </DockPanel>

    <!-- Toolbar -->
    <Grid Grid.Row="1" Margin="0,18,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="420" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Grid>
        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Padding="32,6,32,6" VerticalContentAlignment="Center"
                 AutomationProperties.Name="Search tasks" PreviewKeyDown="OnSearchPreviewKeyDown">
          <TextBox.InputBindings>
            <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
          </TextBox.InputBindings>
        </TextBox>
        <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" Margin="11,0,0,0" IsHitTestVisible="False"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" />
        <TextBlock Text="Search tasks   (Ctrl+F)" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}" />
        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="24" Height="24" Margin="0,0,5,0"
                HorizontalAlignment="Right" ToolTip="Clear search (Esc)" Command="{Binding ClearSearchCommand}" IsTabStop="False"
                Visibility="{Binding SearchText, Converter={StaticResource NullToCollapsed}}" />
      </Grid>

      <ComboBox Grid.Column="1" Width="200" Margin="10,0,0,0" VerticalAlignment="Center"
                ItemsSource="{Binding ClientFilterOptions}" DisplayMemberPath="DisplayName"
                SelectedValuePath="Id" SelectedValue="{Binding ClientFilterKey}"
                AutomationProperties.Name="Filter by stakeholder" />

      <CheckBox Grid.Column="2" Content="Show archived" Margin="14,0,0,0" VerticalAlignment="Center"
                IsChecked="{Binding ShowArchived}" />

      <StackPanel Grid.Column="4" Orientation="Horizontal">
        <ComboBox Width="210" Margin="0,0,8,0" VerticalAlignment="Center" ItemsSource="{Binding TimelineGroupOptions}" DisplayMemberPath="Name"
                  SelectedValuePath="Id" SelectedValue="{Binding TimelineGroupKey}" AutomationProperties.Name="Timeline group filter"
                  Visibility="{Binding ShowTimeline, Converter={StaticResource BoolToVisibility}}" />
        <ToggleButton Padding="12,6" Margin="0,0,8,0" IsChecked="{Binding ShowTimeline}" AutomationProperties.Name="Planning timeline"
                      ToolTip="Planning timeline: the active task queue with estimated effort">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE9D2;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
            <TextBlock Text="Timeline" />
          </StackPanel>
        </ToggleButton>
        <Button Padding="12,6" Margin="0,0,8,0" Command="{Binding EditSelectedCommand}" ToolTip="Edit the selected task (Enter)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE70F;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
            <TextBlock Text="Edit" />
          </StackPanel>
        </Button>
        <Button Padding="14,6" Style="{DynamicResource AccentButtonStyle}" Command="{Binding NewTaskCommand}" ToolTip="New task (Ctrl+N)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
            <TextBlock Text="New task" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="300" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="2*" MinWidth="340" MaxWidth="480" />
      </Grid.ColumnDefinitions>

      <!-- Task list -->
      <Border Style="{StaticResource Card}" Padding="6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Minor Tasks: reminder-only to-dos, first group (never used for time registration or the Board) -->
          <Expander DataContext="{Binding Minor}" IsExpanded="{Binding DataContext.MinorGroup.IsExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                    Margin="0,2,0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Minor Tasks"
                    Visibility="{Binding DataContext.ShowTimeline, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <Expander.Header>
              <Border CornerRadius="4" BorderThickness="4,0,0,0" Padding="10,7" Margin="0,4,0,2" BorderBrush="#A0675E" Background="#24A0675E">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE73A;" Style="{StaticResource IconText}" FontSize="14" Margin="0,1,10,0" Foreground="#A0675E" />
                  <TextBlock Text="Minor Tasks" FontSize="14" FontWeight="SemiBold" />
                  <Border Style="{StaticResource Pill}" Margin="10,0,0,0">
                    <TextBlock Text="{Binding Active.Count}" Style="{StaticResource PillText}" />
                  </Border>
                  <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </Expander.Header>
            <StackPanel Margin="6,4,6,6">
              <!-- Quick add: title, optional reminder, Enter or Add -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                  <TextBox x:Name="MinorTitleBox" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New minor task">
                    <TextBox.InputBindings>
                      <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                    </TextBox.InputBindings>
                  </TextBox>
                  <TextBlock Text="Add a minor task…" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             Visibility="{Binding Text, ElementName=MinorTitleBox, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}" />
                </Grid>
                <DatePicker Grid.Column="1" Width="128" Margin="6,0,0,0" SelectedDate="{Binding NewReminderDate}"
                            AutomationProperties.Name="Reminder date (optional)" ToolTip="Reminder date (optional; empty = no reminder)" />
                <ComboBox Grid.Column="2" Width="82" Margin="6,0,0,0" IsEditable="True" ItemsSource="{Binding QuarterHours}" MaxDropDownHeight="240"
                          Text="{Binding NewReminderTime, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Reminder time"
                          ToolTip="Reminder time (used when a date is set)" />
                <Button Grid.Column="3" Margin="6,0,0,0" Padding="12,5" Content="Add" Command="{Binding AddCommand}" Style="{DynamicResource AccentButtonStyle}" />
              </Grid>
              <TextBlock Text="{Binding AddError}" Style="{StaticResource ErrorText}" />

              <!-- Open minor tasks -->
              <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                <ItemsControl ItemsSource="{Binding Active}" Focusable="False" AutomationProperties.Name="Open minor tasks">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MinorTaskItemViewModel}">
                      <Grid Margin="2,3">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsCompleted}" VerticalAlignment="Top" ToolTip="Mark done" AutomationProperties.Name="{Binding Title}" MinWidth="0" />
                        <StackPanel Grid.Column="1" Margin="2,1,8,0">
                          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                          <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Reminder" Text="{Binding ReminderText, StringFormat='&#x23F0; {0}'}" Style="{StaticResource CaptionText}" Margin="0,0,10,0"
                                       Visibility="{Binding ReminderText, Converter={StaticResource NullToCollapsed}}" />
                            <Ellipse Width="7" Height="7" Margin="0,1,5,0" VerticalAlignment="Center" Fill="{Binding StakeholderColor, Converter={StaticResource HexBrush}}"
                                     Visibility="{Binding HasStakeholder, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Stakeholder}" Style="{StaticResource CaptionText}"
                                       Visibility="{Binding HasStakeholder, Converter={StaticResource BoolToVisibility}}" />
                          </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE70F;" FontSize="12" Width="28" Height="28" ToolTip="Edit"
                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                      </Grid>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                          <Setter TargetName="Reminder" Property="Foreground" Value="#A8463A" />
                          <Setter TargetName="Reminder" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <!-- Inline editor -->
              <Border Style="{StaticResource Card}" Padding="12" Margin="0,8,0,0" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <TextBlock Text="Title" Style="{StaticResource FieldLabelText}" Margin="0,0,0,4" />
                  <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Minor task title" />
                  <TextBlock Text="Description (optional)" Style="{StaticResource FieldLabelText}" />
                  <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="120"
                           VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Minor task description" />
                  <TextBlock Text="Stakeholder (optional)" Style="{StaticResource FieldLabelText}" />
                  <ComboBox ItemsSource="{Binding ClientOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding EditClientKey}"
                            AutomationProperties.Name="Minor task stakeholder" />
                  <TextBlock Text="Reminder (optional)" Style="{StaticResource FieldLabelText}" />
                  <StackPanel Orientation="Horizontal">
                    <DatePicker Width="140" SelectedDate="{Binding EditReminderDate}" AutomationProperties.Name="Minor task reminder date" />
                    <ComboBox Width="82" Margin="6,0,0,0" IsEditable="True" ItemsSource="{Binding QuarterHours}" MaxDropDownHeight="240"
                              Text="{Binding EditReminderTime, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Minor task reminder time" />
                  </StackPanel>
                  <TextBlock Text="{Binding EditError}" Style="{StaticResource ErrorText}" />
                  <DockPanel Margin="0,12,0,0">
                    <Button DockPanel.Dock="Left" Style="{StaticResource SubtleButton}" Command="{Binding DeleteEditingCommand}" ToolTip="Delete this minor task">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Delete" />
                      </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Content="Cancel" Padding="12,5" Margin="0,0,8,0" Command="{Binding CancelEditCommand}" />
                      <Button Content="Save" Padding="14,5" Style="{DynamicResource AccentButtonStyle}" Command="{Binding SaveEditCommand}" />
                    </StackPanel>
                  </DockPanel>
                </StackPanel>
              </Border>

              <!-- Completed minor tasks (untick to reopen) -->
              <Expander Margin="0,8,0,0" HorizontalAlignment="Stretch" AutomationProperties.Name="Completed minor tasks"
                        Visibility="{Binding Completed.Count, Converter={StaticResource CountToVisibility}}">
                <Expander.Header>
                  <TextBlock Style="{StaticResource CaptionText}"><Run Text="Completed (" /><Run Text="{Binding Completed.Count, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                </Expander.Header>
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding Completed}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:MinorTaskItemViewModel}">
                        <StackPanel Orientation="Horizontal" Margin="2,2" Opacity="0.7">
                          <CheckBox IsChecked="{Binding IsCompleted}" ToolTip="Untick to reopen" MinWidth="0" AutomationProperties.Name="{Binding Title}" />
                          <TextBlock Text="{Binding Title}" TextDecorations="Strikethrough" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Expander>
            </StackPanel>
          </Expander>

          <!-- Planning timeline (replaces the list while on; the editor on the right stays) -->
          <DockPanel Grid.Row="1" Visibility="{Binding ShowTimeline, Converter={StaticResource BoolToVisibility}}" Margin="6,4,6,0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                  <Button Padding="10,4" Margin="0,0,6,0" Command="{Binding ExportTimelineExcelCommand}" AutomationProperties.Name="Export timeline to Excel"
                          ToolTip="Excel workbook: the timeline with task bars and working days, plus a Task Data sheet (the tasks shown, in this order)">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xEDE1;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0" />
                      <TextBlock Text="Excel…" />
                    </StackPanel>
                  </Button>
                  <Button Padding="10,4" Content="PDF…" Command="{Binding ExportTimelinePdfCommand}" AutomationProperties.Name="Export timeline to PDF"
                          ToolTip="Printable PDF (landscape) of the timeline as shown" />
                </StackPanel>
                <TextBlock Text="{Binding TimelineSummary}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="Wrap" />
              </DockPanel>
              <WrapPanel Margin="0,4,0,0">
                <Border Width="18" Height="9" CornerRadius="2" Background="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Estimated effort" Style="{StaticResource CaptionText}" Margin="0,0,14,0" />
                <Rectangle Width="18" Height="9" RadiusX="2" RadiusY="2" Fill="#33C0504D" Stroke="#C0504D" StrokeDashArray="2 1.5" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="No estimate: provisional 4 h (not saved)" Style="{StaticResource CaptionText}" Margin="0,0,14,0" />
                <Border Width="18" Height="9" Background="#2EA8463A" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Public holiday" Style="{StaticResource CaptionText}" Margin="0,0,14,0" />
                <Rectangle Width="18" Height="9" Fill="#14B08D57" Stroke="#B08D57" StrokeDashArray="3 2" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Customary day off?" Style="{StaticResource CaptionText}" />
              </WrapPanel>
            </StackPanel>
            <ListBox Style="{StaticResource RowListBox}" ItemsSource="{Binding Timeline}" SelectedItem="{Binding SelectedQueueItem}"
                     IsEnabled="{Binding IsListEnabled}" AutomationProperties.Name="Planning timeline">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:QueueItemViewModel}">
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="26" />
                      <ColumnDefinition Width="2*" MinWidth="140" />
                      <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Position}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                      <TextBlock x:Name="QueueTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,1,6,0" VerticalAlignment="Center" Fill="{Binding StakeholderColor, Converter={StaticResource HexBrush}}" />
                        <TextBlock Text="{Binding Context}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding PlannedText, StringFormat=' · {0}'}" Style="{StaticResource CaptionText}"
                                   Visibility="{Binding PlannedText, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock x:Name="QueueDeadline" Text="{Binding DeadlineText, StringFormat=' · {0}'}" Style="{StaticResource CaptionText}"
                                   Visibility="{Binding DeadlineText, Converter={StaticResource NullToCollapsed}}" />
                      </StackPanel>
                    </StackPanel>
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Before}" />
                        <ColumnDefinition Width="{Binding Block}" />
                        <ColumnDefinition Width="{Binding After}" />
                      </Grid.ColumnDefinitions>

                      <!-- Working-day grid (Mon-Fri, 7.5 h each): dotted day boundaries, holiday highlights -->
                      <ItemsControl Grid.RowSpan="3" Grid.ColumnSpan="3" ItemsSource="{Binding Days}" Focusable="False" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vm:DayCellViewModel}">
                            <Grid x:Name="Cell" Background="Transparent">
                              <Rectangle x:Name="Customary" Stroke="#B08D57" StrokeThickness="1" StrokeDashArray="3 2" Visibility="Collapsed" />
                              <Line X1="0" Y1="0" X2="0" Y2="1" Stretch="Fill" HorizontalAlignment="Left" StrokeThickness="1" StrokeDashArray="1 3"
                                    Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Opacity="0.55" />
                            </Grid>
                            <DataTemplate.Triggers>
                              <DataTrigger Binding="{Binding IsPublicHoliday}" Value="True">
                                <Setter TargetName="Cell" Property="Background" Value="#2EA8463A" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsCustomaryHoliday}" Value="True">
                                <Setter TargetName="Cell" Property="Background" Value="#14B08D57" />
                                <Setter TargetName="Customary" Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </DataTemplate.Triggers>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- Weekday and date labels, above the first row only -->
                      <ItemsControl Grid.ColumnSpan="3" ItemsSource="{Binding Days}" Focusable="False" Margin="0,0,0,3"
                                    Visibility="{Binding ShowDayLabels, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vm:DayCellViewModel}">
                            <TextBlock x:Name="Label" Text="{Binding Label}" ToolTip="{Binding ToolTip}" FontSize="10" Margin="3,0,0,0"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Background="Transparent" />
                            <DataTemplate.Triggers>
                              <DataTrigger Binding="{Binding IsPublicHoliday}" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="#A8463A" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsCustomaryHoliday}" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="#9A7440" />
                                <Setter TargetName="Label" Property="FontStyle" Value="Italic" />
                              </DataTrigger>
                            </DataTemplate.Triggers>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Rectangle x:Name="Bar" Grid.Row="1" Grid.Column="1" RadiusX="3" RadiusY="3" MinWidth="4"
                                 Fill="{Binding StakeholderColor, Converter={StaticResource HexBrush}, ConverterParameter=0.85}" />
                      <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource CaptionText}" FontSize="11" Margin="0,2,0,0">
                        <Run x:Name="Duration" Text="{Binding DurationText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding StartText, Mode=OneWay}" />
                      </TextBlock>
                    </Grid>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding HasDeadline}" Value="True">
                      <Setter TargetName="QueueTitle" Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                      <Setter TargetName="QueueTitle" Property="Foreground" Value="#A8463A" />
                      <Setter TargetName="QueueDeadline" Property="Foreground" Value="#A8463A" />
                      <Setter TargetName="QueueDeadline" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsProvisional}" Value="True">
                      <Setter TargetName="Bar" Property="Fill" Value="#33C0504D" />
                      <Setter TargetName="Bar" Property="Stroke" Value="#C0504D" />
                      <Setter TargetName="Bar" Property="StrokeThickness" Value="1.5" />
                      <Setter TargetName="Bar" Property="StrokeDashArray" Value="3 2" />
                      <Setter TargetName="Duration" Property="Foreground" Value="#C0504D" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <ListBox x:Name="TaskList" Grid.Row="1" Style="{StaticResource RowListBox}" SelectionMode="Extended" SelectionChanged="OnListSelectionChanged"
                   Visibility="{Binding ShowTimeline, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                   ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                   IsEnabled="{Binding IsListEnabled}" KeyDown="OnListKeyDown"
                   AutomationProperties.Name="Tasks">
            <ListBox.InputBindings>
              <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
            </ListBox.InputBindings>
            <ListBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.ContainerStyle>
                  <Style TargetType="GroupItem">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="GroupItem">
                          <Expander IsExpanded="{Binding Name.IsExpanded, Mode=TwoWay}" Margin="0,2,0,4" Padding="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="{Binding Name.Title}">
                            <Expander.Header>
                              <Border CornerRadius="4" BorderThickness="4,0,0,0" Padding="10,7" Margin="0,4,0,2"
                                      BorderBrush="{Binding Name.Color, Converter={StaticResource HexBrush}}"
                                      Background="{Binding Name.Color, Converter={StaticResource HexBrush}, ConverterParameter=0.14}">
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="{Binding Name.Glyph}" Style="{StaticResource IconText}" FontSize="14" Margin="0,1,10,0"
                                             Foreground="{Binding Name.Color, Converter={StaticResource HexBrush}}" />
                                  <TextBlock Text="{Binding Name.Title}" FontSize="14" FontWeight="SemiBold" />
                                  <Border Style="{StaticResource Pill}" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding ItemCount}" Style="{StaticResource PillText}" />
                                  </Border>
                                </StackPanel>
                              </Border>
                            </Expander.Header>
                            <ItemsPresenter />
                          </Expander>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </GroupStyle.ContainerStyle>
              </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:TaskItemViewModel}">
                <Grid x:Name="Row">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="4,0,12,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                      <Ellipse Width="8" Height="8" Margin="0,1,6,0" VerticalAlignment="Center"
                               Fill="{Binding StakeholderColor, Converter={StaticResource HexBrush}}" />
                      <TextBlock Text="{Binding Context}" Style="{StaticResource CaptionText}" />
                      <TextBlock Text="{Binding EstimateText, StringFormat=' · {0}'}" Style="{StaticResource CaptionText}"
                                 Visibility="{Binding HasEstimate, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding WaitingText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" ToolTip="{Binding WaitingText}"
                               Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <TextBlock Text="&#xEA8F;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,8,0" ToolTip="{Binding DeadlineText}"
                                 Foreground="{DynamicResource SystemFillColorCautionBrush}" AutomationProperties.Name="{Binding DeadlineText, TargetNullValue=Deadline}"
                                 Visibility="{Binding HasDeadlineWarning, Converter={StaticResource BoolToVisibility}}" />
                      <Border Style="{StaticResource Pill}" Margin="0,0,6,0" ToolTip="{Binding WaitingText}"
                              Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Waiting" Style="{StaticResource PillText}" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                      </Border>
                      <Border Style="{StaticResource Pill}" Margin="0,0,6,0"
                              Visibility="{Binding IsArchived, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Archived" Style="{StaticResource PillText}" />
                      </Border>
                      <Border Style="{StaticResource Pill}" Visibility="{Binding HasExternalId, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ExternalId}" Style="{StaticResource PillText}" FontFamily="{StaticResource MonoFont}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding LastUsedText}" Style="{StaticResource CaptionText}" FontSize="11"
                               HorizontalAlignment="Right" Margin="0,3,0,0" />
                  </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsArchived}" Value="True">
                    <Setter TargetName="Row" Property="Opacity" Value="0.6" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsClosed}" Value="True">
                    <Setter TargetName="Row" Property="Opacity" Value="0.7" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Empty state -->
          <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" IsHitTestVisible="False"
                      Visibility="{Binding EmptyMessage, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="&#xE9D5;" Style="{StaticResource IconText}" FontSize="32" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="{Binding EmptyMessage}" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>

          <DockPanel Grid.Row="2" Margin="8,6,8,2">
            <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding IsListEnabled}"
                    ToolTip="Delete the selected task (Del). Ctrl+click or Shift+click selects several.">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0" />
                <TextBlock><Run Text="Delete selected" /> <Run Text="{Binding SelectionCount, Mode=OneWay, StringFormat='({0})'}" /></TextBlock>
              </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Margin="0,0,6,0" Content="Select all" Click="OnSelectAll"
                    IsEnabled="{Binding IsListEnabled}" ToolTip="Select every task in the list (Ctrl+A)" />
            <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
          </DockPanel>
        </Grid>
      </Border>

      <!-- Editor -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <Grid>
          <!-- Placeholder when nothing is selected -->
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32"
                      Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <TextBlock Text="&#xE70F;" Style="{StaticResource IconText}" FontSize="28" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Select a task to edit it" Margin="0,10,0,0" HorizontalAlignment="Center" />
            <TextBlock Text="or press Ctrl+N to create one" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
          </StackPanel>

          <Grid x:Name="EditorPanel" DataContext="{Binding Editor}"
                Visibility="{Binding DataContext.HasEditor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
            <Grid.InputBindings>
              <KeyBinding Key="Escape" Command="{Binding DataContext.DiscardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </Grid.InputBindings>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Editor header -->
            <Grid Margin="20,16,12,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding Header}" Style="{StaticResource SectionTitleText}" ToolTip="{Binding Header}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <Border Style="{StaticResource Pill}" Margin="0,0,6,0" Visibility="{Binding IsArchived, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Archived" Style="{StaticResource PillText}" />
                  </Border>
                  <TextBlock Style="{StaticResource CaptionText}" Text="&#x25CF; Unsaved changes"
                             Foreground="{DynamicResource SystemFillColorCautionBrush}"
                             Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                          Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <Button Command="{Binding DataContext.ToggleArchiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                      <Setter Property="Content" Value="&#xE7B8;" />
                      <Setter Property="ToolTip" Value="Archive – hide from pickers, keep history" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsArchived}" Value="True">
                          <Setter Property="Content" Value="&#xE7A7;" />
                          <Setter Property="ToolTip" Value="Restore from archive" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete (Del)"
                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              </StackPanel>
            </Grid>

            <!-- Fields -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,0,20,8">
              <StackPanel>
                <TextBlock Text="Description" Style="{StaticResource FieldLabelText}" />
                <TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"
                         AutomationProperties.Name="Task description" />
                <TextBlock Text="{Binding TitleError}" Style="{StaticResource ErrorText}" />

                <TextBlock Text="Stakeholder" Style="{StaticResource FieldLabelText}" />
                <ComboBox IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                          ItemsSource="{Binding ClientOptions}" DisplayMemberPath="DisplayName"
                          SelectedValuePath="Id" SelectedValue="{Binding ClientId}"
                          Text="{Binding ClientText, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="Stakeholder" />
                <TextBlock Text="{Binding ClientError}" Style="{StaticResource ErrorText}" />
                <Button Style="{StaticResource LinkButton}" Margin="0,6,0,0" HorizontalAlignment="Left"
                        Content="{Binding CreateClientLabel}"
                        Command="{Binding DataContext.CreateClientFromTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Visibility="{Binding CanCreateClient, Converter={StaticResource BoolToVisibility}}" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Task system" Style="{StaticResource FieldLabelText}" />
                    <ComboBox ItemsSource="{Binding TaskSystemOptions}" DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id" SelectedValue="{Binding TaskSystemKey}"
                              AutomationProperties.Name="Task system" />
                    <TextBlock Text="{Binding TaskSystemError}" Style="{StaticResource ErrorText}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Task ID (optional)" Style="{StaticResource FieldLabelText}" />
                    <TextBox Text="{Binding ExternalId, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                             FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="External task ID" />
                    <TextBlock Text="{Binding ExternalIdError}" Style="{StaticResource ErrorText}" />
                  </StackPanel>
                </Grid>

                <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="4"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        Visibility="{Binding SimilarWarning, Converter={StaticResource NullToCollapsed}}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource IconText}" Margin="0,1,8,0" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding SimilarWarning}" TextWrapping="Wrap" FontSize="12" />
                  </DockPanel>
                </Border>

                <TextBlock Text="Deadline (optional)" Style="{StaticResource FieldLabelText}" />
                <DatePicker SelectedDate="{Binding DeadlineDate}" HorizontalAlignment="Left" Width="180" AutomationProperties.Name="Deadline"
                            ToolTip="A bell appears on the task and its Board card when the deadline is near (Settings › Tasks)" />

                <Grid Margin="0,0,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Estimated remaining time" Style="{StaticResource FieldLabelText}" />
                    <TextBox Text="{Binding EstimateText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Estimated remaining time"
                             ToolTip="Hours and minutes, e.g. 2:30, 1.5, 3h or 45m. Leave empty when unknown (the timeline then plans a provisional 4 hours)." />
                    <TextBlock Text="{Binding EstimateError}" Style="{StaticResource ErrorText}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Planned start (optional)" Style="{StaticResource FieldLabelText}" />
                    <DatePicker SelectedDate="{Binding PlannedStartDate}" AutomationProperties.Name="Planned start"
                                ToolTip="Scheduled tasks come first in the timeline, in date order" />
                  </StackPanel>
                </Grid>

                <CheckBox Content="Recurring task" IsChecked="{Binding IsRecurring}" Margin="0,14,0,0"
                          ToolTip="Routine work such as meetings or weekly duties; listed under Recurring Tasks" />
                <CheckBox Content="Waiting for external input" IsChecked="{Binding IsWaiting}" Margin="0,8,0,0"
                          ToolTip="Waiting for information, a response, approval or action from others; listed under Waiting for External Input" />
                <StackPanel Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="Waiting for / Reason (optional)" Style="{StaticResource FieldLabelText}" />
                  <TextBox Text="{Binding WaitingReason, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                           MinHeight="48" MaxHeight="120" VerticalScrollBarVisibility="Auto" MaxLength="1000"
                           AutomationProperties.Name="Waiting for / Reason" />
                  <TextBlock Text="{Binding WaitingReasonError}" Style="{StaticResource ErrorText}" />
                </StackPanel>
                <CheckBox Content="Closed (completed)" IsChecked="{Binding IsClosed}" Margin="0,8,0,0"
                          ToolTip="Completed tasks move to Closed Tasks; clear it to reopen. History and recorded time stay. Archiving instead hides a task." />

                <TextBlock Text="Usual channel (optional)" Style="{StaticResource FieldLabelText}" />
                <ComboBox ItemsSource="{Binding ChannelOptions}" DisplayMemberPath="DisplayName"
                          SelectedValuePath="Id" SelectedValue="{Binding ChannelKey}"
                          AutomationProperties.Name="Usual communication channel" />
                <TextBlock Text="{Binding ChannelError}" Style="{StaticResource ErrorText}" />

                <TextBlock Text="Notes (optional)" Style="{StaticResource FieldLabelText}" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="72" MaxHeight="200" VerticalScrollBarVisibility="Auto" MaxLength="8000"
                         AutomationProperties.Name="Notes" />
                <TextBlock Text="{Binding NotesError}" Style="{StaticResource ErrorText}" />

                <CheckBox Content="Show on Board" IsChecked="{Binding ShowOnBoard}" Margin="0,14,0,0"
                          Visibility="{Binding DataContext.IsBoardEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"
                          ToolTip="Off takes the task's card off the Board (archived); the task and its recorded time stay. On brings the same card back." />
              </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="20,12">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="Discard" Padding="14,5" Margin="0,0,8,0" ToolTip="Discard changes (Esc)"
                          Command="{Binding DataContext.DiscardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  <Button Content="Save" Padding="18,5" Style="{DynamicResource AccentButtonStyle}" ToolTip="Save (Ctrl+S)"
                          Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
                <TextBlock Text="Ctrl+S save · Esc discard" Style="{StaticResource CaptionText}" FontSize="11" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
