<Window x:Class="WorkTrace.App.Views.RegistrationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WorkTrace.App.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:RegistrationEditorViewModel}"
        Title="{Binding Heading}" Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </Window.InputBindings>
  <StackPanel Margin="22,18,22,18">
    <TextBlock Text="{Binding Heading}" Style="{StaticResource SectionTitleText}" FontSize="19" />
    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,6"
               Text="Exact times are kept (rounding only happens in exports). The earlier values stay in the history." />

    <TextBlock Text="Stakeholder" Style="{StaticResource FieldLabelText}" />
    <ComboBox ItemsSource="{Binding ClientOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding ClientKey}"
              AutomationProperties.Name="Stakeholder" />
    <TextBlock Text="Task" Style="{StaticResource FieldLabelText}" />
    <ComboBox ItemsSource="{Binding TaskOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding TaskKey}"
              AutomationProperties.Name="Task" />

    <Grid Margin="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="Date" Style="{StaticResource FieldLabelText}" />
      <DatePicker Grid.Row="1" SelectedDate="{Binding Date}" AutomationProperties.Name="Date" />
      <TextBlock Grid.Column="2" Text="Start" Style="{StaticResource FieldLabelText}" />
      <ComboBox Grid.Row="1" Grid.Column="2" Width="84" IsEditable="True" ItemsSource="{Binding QuarterHours}" MaxDropDownHeight="240"
                Text="{Binding StartText, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Start time" />
      <TextBlock Grid.Column="4" Text="End" Style="{StaticResource FieldLabelText}" />
      <ComboBox Grid.Row="1" Grid.Column="4" Width="84" IsEditable="True" ItemsSource="{Binding QuarterHours}" MaxDropDownHeight="240"
                Text="{Binding EndText, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="End time" />
      <TextBlock Grid.Column="6" Text="Duration" Style="{StaticResource FieldLabelText}" />
      <TextBox Grid.Row="1" Grid.Column="6" Width="70" Text="{Binding DurationText, UpdateSourceTrigger=LostFocus}"
               AutomationProperties.Name="Duration" ToolTip="h:mm, e.g. 1:15 (moves the end)" />
    </Grid>

    <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" Padding="16,6" MinWidth="90" Margin="0,0,8,0" Command="{Binding CancelCommand}" />
      <Button Content="Save" Padding="18,6" MinWidth="90" Style="{DynamicResource AccentButtonStyle}" Command="{Binding SaveCommand}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
