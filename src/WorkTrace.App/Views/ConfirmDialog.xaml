<Window x:Class="WorkTrace.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="24,20,24,20">
    <TextBlock x:Name="HeadingText" Style="{StaticResource SectionTitleText}" FontSize="18" TextWrapping="Wrap" />
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,10,0,24" LineHeight="20" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="ConfirmButton" Padding="16,6" MinWidth="96" Click="OnConfirm" />
      <Button x:Name="CancelButton" Content="Cancel" Padding="16,6" MinWidth="96" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
