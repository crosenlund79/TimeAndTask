<UserControl x:Class="WorkTrace.App.Views.CaptureBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WorkTrace.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600"
             d:DataContext="{d:DesignInstance Type=vm:BoardPageViewModel}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid>
      <TextBox x:Name="CaptureBox" Text="{Binding CaptureText, UpdateSourceTrigger=PropertyChanged}" Padding="32,6,8,6"
               VerticalContentAlignment="Center" MaxLength="2000" AutomationProperties.Name="Quick capture"
               PreviewKeyDown="OnPreviewKeyDown">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding CaptureCommand}" />
        </TextBox.InputBindings>
      </TextBox>
      <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" Margin="11,0,0,0" IsHitTestVisible="False" HorizontalAlignment="Left"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <TextBlock Text="Capture a thought, link or screenshot – Enter saves it to the Inbox   (Ctrl+Shift+C)" Margin="33,0,0,0"
                 VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                 Visibility="{Binding Text, ElementName=CaptureBox, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}" />
    </Grid>
    <Border Grid.Column="1" Style="{StaticResource Pill}" Margin="8,0,0,0" Visibility="{Binding HasCaptureImage, Converter={StaticResource BoolToVisibility}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xE722;" Style="{StaticResource IconText}" FontSize="11" Margin="0,0,6,0" />
        <TextBlock Text="Screenshot attached" Style="{StaticResource PillText}" />
        <Button Style="{StaticResource IconButton}" Width="18" Height="18" FontSize="8" Content="&#xE711;" Margin="4,0,-4,0"
                ToolTip="Remove the screenshot" Command="{Binding ClearCaptureImageCommand}" />
      </StackPanel>
    </Border>
    <Button Grid.Column="2" Margin="8,0,0,0" Padding="14,6" Content="Capture" Command="{Binding CaptureCommand}" ToolTip="Save to the Inbox (Enter)" />
  </Grid>
</UserControl>
