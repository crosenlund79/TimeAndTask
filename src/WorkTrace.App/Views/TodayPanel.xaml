<UserControl x:Class="WorkTrace.App.Views.TodayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WorkTrace.App.ViewModels"
             x:Name="Root"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="600"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}">
  <!-- The day's registrations (Overview "Today" panel). One control for the Overview and Mini Mode: same view model,
       same commands, so both always show the same registrations. -->
  <Border Style="{StaticResource Card}">
    <DockPanel>
      <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding DayTitle}" Style="{StaticResource SectionTitleText}" />
          <TextBlock Text="{Binding RegistrationTotal}" Style="{StaticResource CaptionText}" />
        </StackPanel>
        <!-- Normal: navigation to the right of the title. Compact (Mini Mode): on its own line under the title. -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Grid.Column" Value="1" />
              <Setter Property="Grid.Row" Value="0" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                  <Setter Property="Grid.Column" Value="0" />
                  <Setter Property="Grid.Row" Value="1" />
                  <Setter Property="Margin" Value="-6,6,0,0" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Button Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="12" Command="{Binding PreviousDayCommand}"
                  ToolTip="Previous day" AutomationProperties.Name="Previous day" />
          <DatePicker SelectedDate="{Binding SelectedDate}" Width="130" Margin="4,0" AutomationProperties.Name="Day" />
          <Button Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="12" Command="{Binding NextDayCommand}"
                  ToolTip="Next day" AutomationProperties.Name="Next day" />
          <Button Content="Today" Padding="10,4" Margin="6,0,0,0" Command="{Binding GoToTodayCommand}" />
          <Button Style="{StaticResource IconButton}" Content="&#xE73F;" FontSize="12" Margin="6,0,0,0" Command="{Binding ToggleMiniModeCommand}"
                  ToolTip="Mini Mode: this panel in a small window that stays on top (Ctrl+M)" AutomationProperties.Name="Mini Mode"
                  Visibility="{Binding IsCompact, ElementName=Root, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
        </StackPanel>
      </Grid>
      <!-- Daily task history: every distinct task used on this day (informational; no times) -->
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding HasDayTasks, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="Tasks this day" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding DayTasks}" ItemTemplate="{StaticResource DayTaskTemplate}" Focusable="False"
                        AutomationProperties.Name="Tasks this day">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="MaxWidth" Value="240" />
              </Style>
            </ItemsControl.ItemContainerStyle>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
        <TextBlock Text="{Binding TimesheetNote}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                   Visibility="{Binding TimesheetNote, Converter={StaticResource NullToCollapsed}}" />
        <TextBlock Style="{StaticResource CaptionText}" FontSize="11" TextWrapping="Wrap"
                   Text="The chosen task runs until you choose another, pause or close WorkTrace. Time before the first choice (start-up, after a pause) is unclassified until you choose a task, which then gets it. ≈ = from check-ins. The Timesheet uses the same registrations." />
      </StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="No registrations on this day." Style="{StaticResource CaptionText}" Margin="0,4"
                     Visibility="{Binding HasNoRegistrations, Converter={StaticResource BoolToVisibility}}" />
          <ItemsControl ItemsSource="{Binding Registrations}" Focusable="False" AutomationProperties.Name="Registrations">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:RegistrationItemViewModel}">
                <Grid x:Name="Row" Margin="0,4" ToolTip="{Binding KindText}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Top" Margin="0,1,0,0" />
                  <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <DockPanel>
                      <Border DockPanel.Dock="Right" Margin="6,0,0,0" Padding="6,0" CornerRadius="3" VerticalAlignment="Center"
                              Background="{DynamicResource AccentFillColorDefaultBrush}" AutomationProperties.Name="Active"
                              Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Active" FontSize="11" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                      </Border>
                      <TextBlock x:Name="RowTask" Text="{Binding Task}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <StackPanel x:Name="RowStakeholder" Orientation="Horizontal">
                      <Ellipse Width="8" Height="8" Margin="0,1,6,0" VerticalAlignment="Center"
                               Fill="{Binding StakeholderColor, Converter={StaticResource HexBrush}}" />
                      <TextBlock Text="{Binding Stakeholder}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SelectionText}" Style="{StaticResource CaptionText}" FontSize="11" TextWrapping="Wrap"
                               Visibility="{Binding SelectionText, Converter={StaticResource NullToCollapsed}}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Duration}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,-2,0,0" VerticalAlignment="Top">
                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE70F;"
                            ToolTip="Edit this registration" AutomationProperties.Name="Edit registration"
                            Command="{Binding DataContext.EditRegistrationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11" Content="&#xE74D;" Opacity="0.7"
                            ToolTip="Delete this registration (the time becomes unclassified)" AutomationProperties.Name="Delete registration"
                            Command="{Binding DataContext.DeleteRegistrationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Classify" Padding="10,2" FontSize="12"
                            ToolTip="Assign this time to a task or stakeholder" AutomationProperties.Name="Classify time"
                            Command="{Binding DataContext.EditRegistrationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding CanClassify, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsUnclassified}" Value="True">
                    <Setter TargetName="RowTask" Property="FontStyle" Value="Italic" />
                    <Setter TargetName="RowTask" Property="FontWeight" Value="Normal" />
                    <Setter TargetName="RowStakeholder" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter TargetName="Row" Property="Opacity" Value="0.7" />
                    <Setter TargetName="RowTask" Property="FontWeight" Value="Normal" />
                    <Setter TargetName="RowStakeholder" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter TargetName="Row" Property="Opacity" Value="0.6" />
                    <Setter TargetName="RowTask" Property="FontWeight" Value="Normal" />
                    <Setter TargetName="RowStakeholder" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Expander Margin="0,12,0,0" HorizontalAlignment="Stretch" AutomationProperties.Name="Check-ins and events">
            <Expander.Header>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Check-ins and events" FontWeight="SemiBold" />
                <TextBlock Text="{Binding TodaySummary, StringFormat=' · {0}'}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
              </StackPanel>
            </Expander.Header>
        <ItemsControl ItemsSource="{Binding Today}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:TimelineItemViewModel}">
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="48" />
                  <ColumnDefinition Width="26" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Time}" Style="{StaticResource CaptionText}" VerticalAlignment="Top" Margin="0,1,0,0" />
                <TextBlock x:Name="Glyph" Grid.Column="1" Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="12"
                           VerticalAlignment="Top" Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="2">
                  <TextBlock x:Name="Title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}"
                             Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCheckIn}" Value="True">
                  <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                  <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUncertain}" Value="True">
                  <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
