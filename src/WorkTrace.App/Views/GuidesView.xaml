<UserControl x:Class="WorkTrace.App.Views.GuidesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WorkTrace.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             d:DataContext="{d:DesignInstance Type=vm:GuidesViewModel}">

  <UserControl.InputBindings>
    <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NewGuideCommand}" />
  </UserControl.InputBindings>

  <UserControl.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Find" Executed="OnFind" />
  </UserControl.CommandBindings>

  <UserControl.Resources>
    <CollectionViewSource x:Key="GroupedGuides" Source="{Binding Items}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="CategoryText" />
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Guides" Style="{StaticResource PageTitleText}" />
      <TextBlock Style="{StaticResource PageSubtitleText}"
                 Text="Your how-tos, grouped by category. Guides not changed for six months are marked stale. Edits save automatically." />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,18,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="360" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid>
        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="32,6,32,6"
                 VerticalContentAlignment="Center" AutomationProperties.Name="Search guides">
          <TextBox.InputBindings>
            <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
          </TextBox.InputBindings>
        </TextBox>
        <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" Margin="11,0,0,0" IsHitTestVisible="False" HorizontalAlignment="Left"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="Search titles and text   (Ctrl+F)" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}" />
      </Grid>
      <ComboBox Grid.Column="1" Width="180" Margin="10,0,0,0" ItemsSource="{Binding CategoryFilterOptions}"
                SelectedItem="{Binding CategoryFilter}" AutomationProperties.Name="Filter by category" />
      <CheckBox Grid.Column="2" Content="Only stale" Margin="14,0,0,0" VerticalAlignment="Center" IsChecked="{Binding OnlyStale}" />
      <TextBlock Grid.Column="3" Text="{Binding Summary}" Style="{StaticResource CaptionText}" Margin="14,0,0,0" VerticalAlignment="Center" />
      <Button Grid.Column="4" Padding="14,6" Style="{DynamicResource AccentButtonStyle}" Command="{Binding NewGuideCommand}" ToolTip="New guide (Ctrl+N)">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
          <TextBlock Text="New guide" />
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="280" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="3*" MinWidth="360" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Padding="6">
        <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="8,6,8,2">
          <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Command="{Binding DeleteSelectedCommand}"
                  ToolTip="Delete the selected guides (Del). Ctrl+click or Shift+click selects several.">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0" />
              <TextBlock><Run Text="Delete selected" /> <Run Text="{Binding SelectionCount, Mode=OneWay, StringFormat='({0})'}" /></TextBlock>
            </StackPanel>
          </Button>
          <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Margin="0,0,6,0" Content="Select all" Click="OnSelectAll"
                  ToolTip="Select every guide in the list (Ctrl+A)" />
          <TextBlock />
        </DockPanel>
        <ListBox x:Name="GuideList" Style="{StaticResource RowListBox}" ItemsSource="{Binding Source={StaticResource GroupedGuides}}"
                 SelectedItem="{Binding SelectedItem}" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                 SelectionMode="Extended" SelectionChanged="OnListSelectionChanged"
                 AutomationProperties.Name="Guides">
          <ListBox.InputBindings>
            <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
          </ListBox.InputBindings>
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="10,10,0,4"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:GuideItemViewModel}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="4,0,8,0">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" ToolTip="{Binding CreatedText}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Pill}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibility}}" ToolTip="Not changed for six months or more">
                  <TextBlock Text="Stale" Style="{StaticResource PillText}" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <Grid>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32"
                      Visibility="{Binding HasGuide, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <TextBlock Text="&#xE82D;" Style="{StaticResource IconText}" FontSize="28" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Select a guide to read or edit it" Margin="0,10,0,0" HorizontalAlignment="Center" />
            <TextBlock Text="or press Ctrl+N to write a new one" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
          </StackPanel>

          <Grid Margin="20,16,20,16" Visibility="{Binding HasGuide, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete guide"
                      Command="{Binding DeleteCommand}" VerticalAlignment="Top" />
              <StackPanel>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="18" FontWeight="SemiBold"
                         MaxLength="200" AutomationProperties.Name="Guide title" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">
                  <Run Text="{Binding Dates, Mode=OneWay}" />
                  <Run Text="·" />
                  <Run Text="{Binding SaveState, Mode=OneWay}" />
                </TextBlock>
              </StackPanel>
            </DockPanel>
            <StackPanel Grid.Row="1">
              <TextBlock Text="Category" Style="{StaticResource FieldLabelText}" />
              <ComboBox IsEditable="True" ItemsSource="{Binding Categories}" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                        MaxWidth="320" HorizontalAlignment="Left" MinWidth="220" AutomationProperties.Name="Category"
                        ToolTip="Pick a category or type a new one" />
              <TextBlock Text="Guide" Style="{StaticResource FieldLabelText}" />
            </StackPanel>
            <TextBox Grid.Row="2" Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                     AutomationProperties.Name="Guide text" />

            <!-- Attached PDFs -->
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Command="{Binding AttachPdfCommand}" ToolTip="Attach one or more PDF files">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE723;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0" />
                    <TextBlock Text="Attach PDF…" />
                  </StackPanel>
                </Button>
                <TextBlock Text="Attachments" Style="{StaticResource FieldLabelText}" Margin="0" VerticalAlignment="Center" />
              </DockPanel>
              <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,6,0,0" MaxHeight="160" AutomationProperties.Name="Attachments">
                <ItemsControl.Template>
                  <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsPresenter />
                    </ScrollViewer>
                  </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:GuideFileViewModel}">
                    <DockPanel Margin="0,0,0,2">
                      <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" Content="&#xE74D;" ToolTip="Remove"
                              Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                      <TextBlock Text="&#xEA90;" Style="{StaticResource IconText}" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <StackPanel VerticalAlignment="Center">
                        <Button Style="{StaticResource LinkButton}" Content="{Binding Item.FileName}" HorizontalAlignment="Left" ToolTip="Open in the default PDF viewer"
                                Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <TextBlock Text="{Binding Info}" Style="{StaticResource CaptionText}" FontSize="11" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
