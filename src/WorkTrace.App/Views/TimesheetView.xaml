<UserControl x:Class="WorkTrace.App.Views.TimesheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WorkTrace.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="600"
             d:DataContext="{d:DesignInstance Type=vm:TimesheetViewModel}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Weekly timesheet" Style="{StaticResource PageTitleText}" />
      <TextBlock Style="{StaticResource PageSubtitleText}"
                 Text="Hours per task and day, estimated from your check-ins. Type in a cell to correct it; export when the week looks right." />
    </StackPanel>

    <DockPanel Grid.Row="1" Margin="0,16,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Padding="12,5" Margin="0,0,8,0" Command="{Binding ExportExcelCommand}" ToolTip="Excel workbook: the week grid and one line per day and task">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE9F9;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
            <TextBlock Text="Export to Excel…" />
          </StackPanel>
        </Button>
        <Button Padding="12,5" Content="CSV…" Command="{Binding ExportCsvCommand}" ToolTip="One line per day and task (date, stakeholder, reference, task, hours, comments)" />
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource IconButton}" Content="&#xE76B;" ToolTip="Previous week" Command="{Binding PreviousWeekCommand}" />
        <Button Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="Next week" Command="{Binding NextWeekCommand}" Margin="2,0,10,0" />
        <TextBlock Text="{Binding WeekTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Content="This week" Padding="10,3" Margin="12,0,0,0" Command="{Binding ThisWeekCommand}" />
        <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="14,0,0,0" />
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="2" Margin="0,0,0,10" Padding="10,6" CornerRadius="4" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
            Visibility="{Binding Warning, Converter={StaticResource NullToCollapsed}}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource IconText}" Margin="0,0,8,0" />
        <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="6,0,6,6" TextElement.FontWeight="SemiBold">
          <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="*" MinWidth="160" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Stakeholder" />
                <TextBlock Grid.Column="1" Text="Reference" />
                <TextBlock Grid.Column="2" Text="Task" />
                <TextBlock Grid.Column="3" Text="{Binding DayHeaders[0]}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                <TextBlock Grid.Column="4" Text="{Binding DayHeaders[1]}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                <TextBlock Grid.Column="5" Text="{Binding DayHeaders[2]}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                <TextBlock Grid.Column="6" Text="{Binding DayHeaders[3]}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                <TextBlock Grid.Column="7" Text="{Binding DayHeaders[4]}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                <TextBlock Grid.Column="8" Text="{Binding DayHeaders[5]}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                <TextBlock Grid.Column="9" Text="{Binding DayHeaders[6]}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                <TextBlock Grid.Column="10" Text="Total" HorizontalAlignment="Right" Margin="0,0,8,0" />
                <TextBlock Grid.Column="11" Text="Comments (from check-ins)" Margin="8,0,0,0" />
        </Grid>
        <Border DockPanel.Dock="Top" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" AutomationProperties.Name="Timesheet">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TimesheetRowViewModel}">
                  <Grid x:Name="Row" Margin="6,1">
                    <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="*" MinWidth="160" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Stakeholder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Stakeholder}" />
                    <TextBlock Grid.Column="1" Text="{Binding Reference}" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Task}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Task}" Margin="0,0,8,0" />
                    <TextBox Grid.Column="3" Text="{Binding Cells[0].Text, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding Cells[0].ToolTip}"
                             HorizontalContentAlignment="Right" Margin="2,1" MinWidth="0" Padding="4,3"
                             Visibility="{Binding Cells[0].IsEditable, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="{Binding DataContext.DayHeaders[0], RelativeSource={RelativeSource AncestorType=UserControl}}">
                      <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Cells[0].IsAdjusted}" Value="True">
                              <Setter Property="FontWeight" Value="SemiBold" />
                              <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Cells[0].BaselineChanged}" Value="True">
                              <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBox.Style>
                    </TextBox>
                    <TextBlock Grid.Column="3" Text="{Binding Cells[0].Text}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding Cells[0].IsEditable, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <TextBox Grid.Column="4" Text="{Binding Cells[1].Text, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding Cells[1].ToolTip}"
                             HorizontalContentAlignment="Right" Margin="2,1" MinWidth="0" Padding="4,3"
                             Visibility="{Binding Cells[1].IsEditable, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="{Binding DataContext.DayHeaders[1], RelativeSource={RelativeSource AncestorType=UserControl}}">
                      <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Cells[1].IsAdjusted}" Value="True">
                              <Setter Property="FontWeight" Value="SemiBold" />
                              <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Cells[1].BaselineChanged}" Value="True">
                              <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBox.Style>
                    </TextBox>
                    <TextBlock Grid.Column="4" Text="{Binding Cells[1].Text}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding Cells[1].IsEditable, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <TextBox Grid.Column="5" Text="{Binding Cells[2].Text, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding Cells[2].ToolTip}"
                             HorizontalContentAlignment="Right" Margin="2,1" MinWidth="0" Padding="4,3"
                             Visibility="{Binding Cells[2].IsEditable, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="{Binding DataContext.DayHeaders[2], RelativeSource={RelativeSource AncestorType=UserControl}}">
                      <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Cells[2].IsAdjusted}" Value="True">
                              <Setter Property="FontWeight" Value="SemiBold" />
                              <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Cells[2].BaselineChanged}" Value="True">
                              <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBox.Style>
                    </TextBox>
                    <TextBlock Grid.Column="5" Text="{Binding Cells[2].Text}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding Cells[2].IsEditable, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <TextBox Grid.Column="6" Text="{Binding Cells[3].Text, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding Cells[3].ToolTip}"
                             HorizontalContentAlignment="Right" Margin="2,1" MinWidth="0" Padding="4,3"
                             Visibility="{Binding Cells[3].IsEditable, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="{Binding DataContext.DayHeaders[3], RelativeSource={RelativeSource AncestorType=UserControl}}">
                      <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Cells[3].IsAdjusted}" Value="True">
                              <Setter Property="FontWeight" Value="SemiBold" />
                              <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Cells[3].BaselineChanged}" Value="True">
                              <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBox.Style>
                    </TextBox>
                    <TextBlock Grid.Column="6" Text="{Binding Cells[3].Text}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding Cells[3].IsEditable, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <TextBox Grid.Column="7" Text="{Binding Cells[4].Text, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding Cells[4].ToolTip}"
                             HorizontalContentAlignment="Right" Margin="2,1" MinWidth="0" Padding="4,3"
                             Visibility="{Binding Cells[4].IsEditable, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="{Binding DataContext.DayHeaders[4], RelativeSource={RelativeSource AncestorType=UserControl}}">
                      <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Cells[4].IsAdjusted}" Value="True">
                              <Setter Property="FontWeight" Value="SemiBold" />
                              <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Cells[4].BaselineChanged}" Value="True">
                              <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBox.Style>
                    </TextBox>
                    <TextBlock Grid.Column="7" Text="{Binding Cells[4].Text}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding Cells[4].IsEditable, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <TextBox Grid.Column="8" Text="{Binding Cells[5].Text, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding Cells[5].ToolTip}"
                             HorizontalContentAlignment="Right" Margin="2,1" MinWidth="0" Padding="4,3"
                             Visibility="{Binding Cells[5].IsEditable, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="{Binding DataContext.DayHeaders[5], RelativeSource={RelativeSource AncestorType=UserControl}}">
                      <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Cells[5].IsAdjusted}" Value="True">
                              <Setter Property="FontWeight" Value="SemiBold" />
                              <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Cells[5].BaselineChanged}" Value="True">
                              <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBox.Style>
                    </TextBox>
                    <TextBlock Grid.Column="8" Text="{Binding Cells[5].Text}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding Cells[5].IsEditable, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <TextBox Grid.Column="9" Text="{Binding Cells[6].Text, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding Cells[6].ToolTip}"
                             HorizontalContentAlignment="Right" Margin="2,1" MinWidth="0" Padding="4,3"
                             Visibility="{Binding Cells[6].IsEditable, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="{Binding DataContext.DayHeaders[6], RelativeSource={RelativeSource AncestorType=UserControl}}">
                      <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Cells[6].IsAdjusted}" Value="True">
                              <Setter Property="FontWeight" Value="SemiBold" />
                              <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Cells[6].BaselineChanged}" Value="True">
                              <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBox.Style>
                    </TextBox>
                    <TextBlock Grid.Column="9" Text="{Binding Cells[6].Text}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding Cells[6].IsEditable, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <TextBlock Grid.Column="10" Text="{Binding TotalText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="11" Text="{Binding Comments}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Comments}"
                               Style="{StaticResource CaptionText}" Margin="8,0,0,0" />
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsTotal}" Value="True">
                      <Setter TargetName="Row" Property="TextElement.FontWeight" Value="SemiBold" />
                      <Setter TargetName="Row" Property="Margin" Value="6,8,6,1" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsUnclassified}" Value="True">
                      <Setter TargetName="Row" Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Text="No registered time this week yet. Check-ins appear here as estimated hours." HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,40,0,0"
                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False" />
        </Grid>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
