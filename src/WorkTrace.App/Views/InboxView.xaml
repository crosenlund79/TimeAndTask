<UserControl x:Class="WorkTrace.App.Views.InboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WorkTrace.App.ViewModels"
             xmlns:views="clr-namespace:WorkTrace.App.Views"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             PreviewKeyDown="OnPagePreviewKeyDown"
             d:DataContext="{d:DesignInstance Type=vm:InboxViewModel}">

  <UserControl.InputBindings>
    <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CloseCardCommand}" />
  </UserControl.InputBindings>

  <UserControl.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Find" Executed="OnFind" />
  </UserControl.CommandBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel>
      <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource IconButton}" Content="&#xE7A7;" Command="{Binding UndoCommand}"
              ToolTip="{Binding Session.UndoToolTip}" IsEnabled="{Binding Session.CanUndo}" AutomationProperties.Name="Undo" />
      <TextBlock Style="{StaticResource PageSubtitleText}" VerticalAlignment="Center"
                 Text="Capture first, organise later. Open an item to add notes, links or screenshots, then put it on the Board or archive it." />
    </DockPanel>

    <views:CaptureBar x:Name="Capture" Grid.Row="1" Margin="0,14,0,0" />

    <Grid Grid.Row="2" Margin="0,10,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="360" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid>
        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="32,6,32,6"
                 VerticalContentAlignment="Center" AutomationProperties.Name="Search the Inbox">
          <TextBox.InputBindings>
            <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
          </TextBox.InputBindings>
        </TextBox>
        <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" Margin="11,0,0,0" IsHitTestVisible="False" HorizontalAlignment="Left"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="Search the Inbox   (Ctrl+F)" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}" />
      </Grid>
      <TextBlock Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource CaptionText}" Margin="12,0,0,0" VerticalAlignment="Center" />
    </Grid>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Padding="6">
        <Grid>
          <ListBox x:Name="ItemList" Style="{StaticResource RowListBox}" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                   AutomationProperties.Name="Inbox items">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:CardItemViewModel}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="4,0,12,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0">
                      <Run Text="{Binding Key, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                      <Run Text="{Binding Meta, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,10,0" VerticalAlignment="Center"
                               Visibility="{Binding AttachmentCount, Converter={StaticResource CountToVisibility}}">
                      <Run Text="&#xE722;" FontFamily="{StaticResource IconFont}" /> <Run Text="{Binding AttachmentCount, Mode=OneWay}" />
                    </TextBlock>
                    <Button Style="{StaticResource SubtleButton}" Content="To board" Margin="0,0,6,0" ToolTip="Put it in the Backlog"
                            Command="{Binding DataContext.ToBoardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE7B8;" ToolTip="Archive"
                            Command="{Binding DataContext.ArchiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" IsHitTestVisible="False"
                      Visibility="{Binding EmptyMessage, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="&#xE70B;" Style="{StaticResource IconText}" FontSize="32" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="{Binding EmptyMessage}" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1" Width="420" Margin="12,0,0,0" Style="{StaticResource Card}" Padding="0"
              Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
        <views:CardDetailView DataContext="{Binding Detail}" />
      </Border>
    </Grid>
  </Grid>
</UserControl>
