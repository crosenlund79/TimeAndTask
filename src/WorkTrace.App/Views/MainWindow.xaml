<Window x:Class="WorkTrace.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WorkTrace.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="WorkTrace"
        Icon="pack://application:,,,/Assets/worktrace.ico"
        Width="760" Height="560" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
      <Image Source="pack://application:,,,/Assets/worktrace.ico" Width="40" Height="40" Margin="0,0,14,0" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="WorkTrace" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Opacity="0.7">
          <Run Text="Personal work log &amp; timesheet assistant · v" /><Run Text="{Binding Version, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </StackPanel>

    <!-- Error banner -->
    <Border Grid.Row="1" Padding="12,8" Margin="0,0,0,12" CornerRadius="4" Background="#33DC2626"
            Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
      <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>

      <!-- Storage status -->
      <GroupBox Header="Local data">
        <Grid Margin="4" DataContext="{Binding Status}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid.Resources>
            <Style TargetType="TextBlock">
              <Setter Property="Margin" Value="0,3,12,3" />
              <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
          </Grid.Resources>

          <TextBlock Grid.Row="0" Text="Data folder" Opacity="0.7" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DataDirectory}" ToolTip="{Binding DataDirectory}" />
          <TextBlock Grid.Row="1" Text="Database" Opacity="0.7" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DatabasePath}" ToolTip="{Binding DatabasePath}" />
          <TextBlock Grid.Row="2" Text="Schema" Opacity="0.7" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AppliedMigrations.Count, StringFormat={}{0} migration(s) applied}" />
          <TextBlock Grid.Row="3" Text="Clients" Opacity="0.7" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ClientCount}" />
          <TextBlock Grid.Row="4" Text="Tasks" Opacity="0.7" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TaskCount}" />
          <TextBlock Grid.Row="5" Text="Observations" Opacity="0.7" />
          <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ObservationCount}" />
          <TextBlock Grid.Row="6" Text="Lookups" Opacity="0.7" />
          <TextBlock Grid.Row="6" Grid.Column="1">
            <Run Text="{Binding TaskSystemCount, Mode=OneWay}" /><Run Text=" task systems · " /><Run Text="{Binding ChannelCount, Mode=OneWay}" /><Run Text=" channels" />
          </TextBlock>

          <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,16,0,0">
            <Button Content="Open data folder" Padding="12,5" Margin="0,0,8,0"
                    Command="{Binding DataContext.OpenDataFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Content="Refresh" Padding="12,5"
                    Command="{Binding DataContext.LoadCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
          </StackPanel>
        </Grid>
      </GroupBox>

      <!-- Roadmap -->
      <GroupBox Grid.Column="2" Header="Not yet available">
        <ItemsControl ItemsSource="{Binding Roadmap}" Margin="4">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,4">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Phase}" Opacity="0.6" Margin="8,0,0,0" />
                <TextBlock Text="{Binding Feature}" TextWrapping="Wrap" />
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </GroupBox>
    </Grid>
  </Grid>
</Window>
