<Window x:Class="WorkTrace.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WorkTrace.App.ViewModels"
        xmlns:views="clr-namespace:WorkTrace.App.Views"
        xmlns:shell="clr-namespace:WorkTrace.App.Shell"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="WorkTrace"
        Icon="pack://application:,,,/WorkTrace;component/Assets/worktrace.ico"
        Width="1080" Height="700" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen">

  <Window.InputBindings>
    <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding GoToSectionCommand}" CommandParameter="{x:Static shell:AppSection.Home}" />
    <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding GoToSectionCommand}" CommandParameter="{x:Static shell:AppSection.Tasks}" />
    <KeyBinding Modifiers="Ctrl" Key="D3" Command="{Binding GoToSectionCommand}" CommandParameter="{x:Static shell:AppSection.Clients}" />
    <KeyBinding Modifiers="Ctrl" Key="D4" Command="{Binding GoToSectionCommand}" CommandParameter="{x:Static shell:AppSection.Lists}" />
    <KeyBinding Modifiers="Ctrl" Key="D5" Command="{Binding GoToSectionCommand}" CommandParameter="{x:Static shell:AppSection.Settings}" />
  </Window.InputBindings>

  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TasksViewModel}">
      <views:TasksView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ClientsViewModel}">
      <views:ClientsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ListsViewModel}">
      <views:ListsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="208" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Navigation rail -->
    <DockPanel Margin="12,16,8,12">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,20">
        <Image Source="pack://application:,,,/WorkTrace;component/Assets/worktrace.ico" Width="28" Height="28" Margin="0,0,10,0" />
        <TextBlock Text="WorkTrace" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock DockPanel.Dock="Bottom" Margin="12,8,0,0" Style="{StaticResource CaptionText}" FontSize="11"
                 Text="Data is stored only on this PC" ToolTip="All data lives under %LocalAppData%\WorkTrace" />

      <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
               Background="Transparent" BorderThickness="0"
               ItemContainerStyle="{StaticResource NavListBoxItem}"
               AutomationProperties.Name="Navigation">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:NavigationItem}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding Shortcut}">
              <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="16" Margin="2,0,12,0" />
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Page -->
    <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
      <ContentControl Content="{Binding SelectedSection.Page}" Margin="28,22,28,20" Focusable="False" />
    </Border>

    <!-- Notification (toast) -->
    <Border Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="208,0,0,24"
            MinWidth="320" MaxWidth="640" Padding="14,10" CornerRadius="8"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
            DataContext="{Binding Notifications}"
            Visibility="{Binding Current, Converter={StaticResource NullToCollapsed}}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" />
      </Border.Effect>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock FontSize="16" Margin="0,0,12,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
              <Setter Property="Text" Value="&#xE946;" />
              <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Current.Kind}" Value="{x:Static shell:NotificationKind.Success}">
                  <Setter Property="Text" Value="&#xE73E;" />
                  <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Current.Kind}" Value="{x:Static shell:NotificationKind.Warning}">
                  <Setter Property="Text" Value="&#xE7BA;" />
                  <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Current.Kind}" Value="{x:Static shell:NotificationKind.Error}">
                  <Setter Property="Text" Value="&#xE783;" />
                  <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Grid.Column="1" Text="{Binding Current.Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="2" Margin="16,0,0,0" Padding="12,4"
                Content="{Binding Current.ActionText}" Command="{Binding Current.Action}"
                Visibility="{Binding Current.ActionText, Converter={StaticResource NullToCollapsed}}" />
        <Button Grid.Column="3" Style="{StaticResource IconButton}" Margin="8,0,-4,0" Content="&#xE711;"
                ToolTip="Dismiss" Command="{Binding DismissCommand}" />
      </Grid>
    </Border>
  </Grid>
</Window>
