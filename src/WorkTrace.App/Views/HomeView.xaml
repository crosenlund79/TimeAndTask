<UserControl x:Class="WorkTrace.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WorkTrace.App.ViewModels"
             xmlns:shell="clr-namespace:WorkTrace.App.Shell"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Overview" Style="{StaticResource PageTitleText}" />
      <TextBlock Style="{StaticResource PageSubtitleText}" Text="What WorkTrace has recorded today, and quick access to your tasks and stakeholders." />
    </StackPanel>

    <!-- Tracking status -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,14,0" VerticalAlignment="Center"
                Background="{DynamicResource SubtleFillColorTertiaryBrush}">
          <TextBlock x:Name="StateGlyph" FontSize="16" HorizontalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                <Setter Property="Text" Value="&#xE769;" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Tracking.IsTracking}" Value="True">
                    <Setter Property="Text" Value="&#xE916;" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Tracking.StatusText}" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Tracking.StatusDetail}" Style="{StaticResource CaptionText}" />
          <TextBlock Text="{Binding Tracking.LastAttemptText}" Style="{StaticResource CaptionText}"
                     Visibility="{Binding Tracking.LastAttemptText, Converter={StaticResource NullToCollapsed}}" />
          <TextBlock Text="{Binding Tracking.Warning}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"
                     Foreground="{DynamicResource SystemFillColorCautionBrush}"
                     Visibility="{Binding Tracking.HasWarning, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Padding="14,6" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" Command="{Binding Tracking.RecordNowCommand}"
                  ToolTip="Record what you are working on (global shortcut, see Settings)">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
              <TextBlock Text="Record activity" />
            </StackPanel>
          </Button>
          <Button Padding="14,6" Content="Pause 1 hour" Command="{Binding Tracking.PauseCommand}" CommandParameter="60"
                  Visibility="{Binding Tracking.IsTracking, Converter={StaticResource BoolToVisibility}}" />
          <Button Padding="14,6" Content="Resume" Command="{Binding Tracking.ResumeCommand}"
                  Visibility="{Binding Tracking.IsPaused, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="2*" MinWidth="250" MaxWidth="360" />
      </Grid.ColumnDefinitions>

      <!-- Today -->
      <Border Style="{StaticResource Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Today" Style="{StaticResource SectionTitleText}" />
            <TextBlock Text="{Binding TodaySummary}" Style="{StaticResource CaptionText}" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource CaptionText}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="Recorded facts only. Time estimates and corrections arrive with the activity log (Phase 4)." />
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Today}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TimelineItemViewModel}">
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="48" />
                      <ColumnDefinition Width="26" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}" Style="{StaticResource CaptionText}" VerticalAlignment="Top" Margin="0,1,0,0" />
                    <TextBlock x:Name="Glyph" Grid.Column="1" Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="12"
                               VerticalAlignment="Top" Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="2">
                      <TextBlock x:Name="Title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}"
                                 Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsCheckIn}" Value="True">
                      <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                      <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsUncertain}" Value="True">
                      <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Right column -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource Card}" Padding="8">
            <StackPanel>
              <Button Padding="10,8" HorizontalContentAlignment="Left" Margin="0,0,0,4" Command="{Binding NavigateCommand}"
                      CommandParameter="{x:Static shell:AppSection.Tasks}" Background="Transparent" BorderThickness="0">
                <DockPanel>
                  <TextBlock Text="&#xE9D5;" Style="{StaticResource IconText}" Margin="0,0,12,0" />
                  <TextBlock Text="{Binding Status.TaskCount, StringFormat={}{0} tasks, FallbackValue=Tasks}" />
                </DockPanel>
              </Button>
              <Button Padding="10,8" HorizontalContentAlignment="Left" Margin="0,0,0,4" Command="{Binding NavigateCommand}"
                      CommandParameter="{x:Static shell:AppSection.Clients}" Background="Transparent" BorderThickness="0">
                <DockPanel>
                  <TextBlock Text="&#xE716;" Style="{StaticResource IconText}" Margin="0,0,12,0" />
                  <TextBlock Text="{Binding Status.ClientCount, StringFormat={}{0} clients, FallbackValue=Clients}" />
                </DockPanel>
              </Button>
              <StackPanel Orientation="Horizontal" Margin="6,6,0,2">
                <Button Content="New task" Padding="12,4" Margin="0,0,8,0" Command="{Binding NewTaskCommand}" />
                <Button Content="New stakeholder" Padding="12,4" Command="{Binding NewClientCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="Local data" Style="{StaticResource SectionTitleText}" />
              <TextBlock Text="{Binding Status.DataDirectory}" ToolTip="{Binding Status.DataDirectory}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
              <TextBlock Style="{StaticResource CaptionText}">
                <Run Text="Version " /><Run Text="{Binding Version, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Status.AppliedMigrations.Count, Mode=OneWay, FallbackValue=0}" /><Run Text=" migration(s)" />
              </TextBlock>
              <Button Content="Open data folder" Padding="12,4" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding OpenDataFolderCommand}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="Coming next" Style="{StaticResource SectionTitleText}" />
              <ItemsControl ItemsSource="{Binding Roadmap}" Margin="0,6,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:RoadmapItem}">
                    <DockPanel Margin="0,3">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Phase}" Style="{StaticResource CaptionText}" Margin="8,0,0,0" />
                      <TextBlock Text="{Binding Feature}" TextWrapping="Wrap" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
