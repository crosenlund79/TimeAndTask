<UserControl x:Class="WorkTrace.App.Views.CardDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WorkTrace.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="800"
             d:DataContext="{d:DesignInstance Type=vm:CardDetailViewModel}"
             AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" PreviewKeyDown="OnPreviewKeyDown">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Margin="20,14,12,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Key}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Border Style="{StaticResource Pill}" Margin="8,0,0,0" Visibility="{Binding IsArchived, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Archived" Style="{StaticResource PillText}" />
          </Border>
          <TextBlock Text="{Binding SaveState}" Style="{StaticResource CaptionText}" Margin="10,0,0,0" VerticalAlignment="Center"
                     AutomationProperties.Name="Save state" />
        </StackPanel>
        <TextBlock Text="{Binding Meta}" Style="{StaticResource CaptionText}" FontSize="11" Margin="0,2,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Style="{StaticResource SubtleButton}" Margin="0,0,6,0" Command="{Binding ToBoardCommand}"
                ToolTip="Put this item on the board (Backlog)"
                Visibility="{Binding IsInbox, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8A0;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0" />
            <TextBlock Text="To board" />
          </StackPanel>
        </Button>
        <Button Command="{Binding ToggleArchiveCommand}">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
              <Setter Property="Content" Value="&#xE7B8;" />
              <Setter Property="ToolTip" Value="Archive – hide from the board, keep everything" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsArchived}" Value="True">
                  <Setter Property="Content" Value="&#xE7A7;" />
                  <Setter Property="ToolTip" Value="Restore from the archive" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close (Esc)"
                Command="{Binding DataContext.CloseCardCommand, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=2}}" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,0,20,16">
      <StackPanel>
        <TextBlock Text="Title" Style="{StaticResource FieldLabelText}" Margin="0,4,0,4" />
        <TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" TextWrapping="Wrap"
                 FontWeight="SemiBold" AutomationProperties.Name="Card title" />
        <TextBlock Text="{Binding TitleError}" Style="{StaticResource ErrorText}" />

        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Status" Style="{StaticResource FieldLabelText}" />
            <ComboBox ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectedValue="{Binding StatusKey}" AutomationProperties.Name="Status"
                      IsEnabled="{Binding IsArchived, Converter={StaticResource InverseBool}}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Category" Style="{StaticResource FieldLabelText}" />
            <ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectedValue="{Binding CategoryKey}" AutomationProperties.Name="Category" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="Priority" Style="{StaticResource FieldLabelText}" />
            <ComboBox ItemsSource="{Binding PriorityOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectedValue="{Binding PriorityKey}" AutomationProperties.Name="Priority" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Description" Style="{StaticResource FieldLabelText}" />
        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="60" MaxHeight="260" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Description" />

        <TextBlock Text="Acceptance criteria (one per line)" Style="{StaticResource FieldLabelText}" />
        <TextBox Text="{Binding Acceptance, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="44" MaxHeight="200" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Acceptance criteria" />

        <TextBlock Text="Notes" Style="{StaticResource FieldLabelText}" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="60" MaxHeight="300" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Notes" />

        <TextBlock Text="Evidence (tests, CI runs)" Style="{StaticResource FieldLabelText}" />
        <TextBox Text="{Binding Evidence, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="32" MaxHeight="200" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Evidence" />

        <!-- Screenshots -->
        <DockPanel Margin="0,16,0,6">
          <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Command="{Binding BrowseAttachmentsCommand}"
                  ToolTip="Add screenshots or files from disk">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE723;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0" />
              <TextBlock Text="Browse…" />
            </StackPanel>
          </Button>
          <TextBlock Text="Screenshots" Style="{StaticResource SectionTitleText}" FontSize="14" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None"
                   Text="Paste with Ctrl+V or drop images here. Stored only on this PC, in the WorkTrace data folder." />
        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,6,0,0" AutomationProperties.Name="Screenshots">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:AttachmentItemViewModel}">
              <Border Width="172" Margin="0,0,8,8" Padding="6" CornerRadius="6" BorderThickness="1"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <StackPanel>
                  <Button Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" Cursor="Hand" ToolTip="{Binding Name}" Padding="0" Height="100"
                          AutomationProperties.Name="{Binding Name}">
                    <Grid>
                      <Image Source="{Binding FullPath, Converter={StaticResource Thumbnail}, ConverterParameter=320}" Stretch="Uniform"
                             Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                      <StackPanel VerticalAlignment="Center" Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource IconText}" FontSize="24" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="4,4,4,0" />
                      </StackPanel>
                    </Grid>
                  </Button>
                  <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="26" Content="&#xE74D;"
                            ToolTip="Remove" Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource CaptionText}" FontSize="11" VerticalAlignment="Center" />
                  </DockPanel>
                  <TextBox Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" MaxLength="500" FontSize="12"
                           AutomationProperties.Name="Caption" ToolTip="Caption (saved when you leave the box)" LostKeyboardFocus="OnCaptionLostFocus" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Links -->
        <TextBlock Text="Links" Style="{StaticResource SectionTitleText}" FontSize="14" Margin="0,16,0,6" />
        <ItemsControl ItemsSource="{Binding Links}" AutomationProperties.Name="Links">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:LinkItemViewModel}">
              <DockPanel Margin="0,0,0,2">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" Content="&#xE74D;" ToolTip="Remove link"
                        Command="{Binding DataContext.RemoveLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" Content="&#xE8C8;" ToolTip="Copy link"
                        Command="{Binding DataContext.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                <Button Style="{StaticResource LinkButton}" Content="{Binding Label}" ToolTip="{Binding Url}" VerticalAlignment="Center"
                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding NewLinkLabel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New link label"
                   ToolTip="Label (optional)" />
          <TextBox Grid.Column="2" Text="{Binding NewLinkUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New link address"
                   ToolTip="https://…">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding AddLinkCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE710;" Margin="4,0,0,0" ToolTip="Add link (Enter)"
                  Command="{Binding AddLinkCommand}" />
        </Grid>
        <TextBlock Text="{Binding LinkError}" Style="{StaticResource ErrorText}" />

        <!-- Dependencies -->
        <TextBlock Text="Blocked by" Style="{StaticResource SectionTitleText}" FontSize="14" Margin="0,16,0,6" />
        <ItemsControl ItemsSource="{Binding BlockedBy}" AutomationProperties.Name="Blocked by">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:DependencyItemViewModel}">
              <DockPanel Margin="0,0,0,2">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" Content="&#xE711;" FontSize="10"
                        ToolTip="Remove dependency"
                        Command="{Binding DataContext.RemoveDependencyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Key, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                  <Run Text="{Binding Title, Mode=OneWay}" />
                  <Run Text="{Binding StatusText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </TextBlock>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ComboBox ItemsSource="{Binding DependencyOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                  SelectedValue="{Binding DependencyKey}" Margin="0,4,0,0" AutomationProperties.Name="Add dependency" />
        <TextBlock Text="{Binding DependencyError}" Style="{StaticResource ErrorText}" />

        <!-- Time tracking -->
        <TextBlock Text="Time tracking" Style="{StaticResource SectionTitleText}" FontSize="14" Margin="0,16,0,6" />
        <ComboBox ItemsSource="{Binding TaskOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                  SelectedValue="{Binding TaskKey}" AutomationProperties.Name="Tracked task"
                  ToolTip="The task you pick in check-ins when you work on this card" />
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox ItemsSource="{Binding ClientOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                    SelectedValue="{Binding ClientKey}" AutomationProperties.Name="Stakeholder for a new task" />
          <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Margin="6,0,0,0" Command="{Binding CreateTaskCommand}"
                  Content="Create task" ToolTip="Create a task with this card's title for the chosen stakeholder and link it" />
        </Grid>

        <!-- Comments -->
        <TextBlock Text="Comments" Style="{StaticResource SectionTitleText}" FontSize="14" Margin="0,16,0,6" />
        <ItemsControl ItemsSource="{Binding Comments}" AutomationProperties.Name="Comments">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:CommentLineViewModel}">
              <Border Margin="0,0,0,6" Padding="10,6" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <StackPanel>
                  <TextBlock Style="{StaticResource CaptionText}" FontSize="11">
                    <Run Text="{Binding Author, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="·" />
                    <Run Text="{Binding When, Mode=OneWay}" />
                  </TextBlock>
                  <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                           Background="Transparent" Padding="0" Margin="0,2,0,0" AutomationProperties.Name="Comment" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding NewComment, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="32" MaxHeight="160" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="New comment"
                   ToolTip="Comments cannot be edited or removed (Ctrl+Enter adds)">
            <TextBox.InputBindings>
              <KeyBinding Modifiers="Ctrl" Key="Enter" Command="{Binding AddCommentCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Margin="6,0,0,0" VerticalAlignment="Top"
                  Content="Comment" Command="{Binding AddCommentCommand}" />
        </Grid>

        <!-- History -->
        <Expander Header="History" Margin="0,16,0,0">
          <ItemsControl ItemsSource="{Binding History}" Margin="0,6,0,0" AutomationProperties.Name="History">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:HistoryLineViewModel}">
                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,3">
                  <Run Text="{Binding When, Mode=OneWay}" />
                  <Run Text="{Binding Text, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
