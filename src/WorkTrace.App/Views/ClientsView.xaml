<UserControl x:Class="WorkTrace.App.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WorkTrace.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             d:DataContext="{d:DesignInstance Type=vm:ClientsViewModel}">

  <UserControl.InputBindings>
    <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NewClientCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCommand}" />
  </UserControl.InputBindings>

  <UserControl.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Find" Executed="OnFind" />
  </UserControl.CommandBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Clients" Style="{StaticResource PageTitleText}" />
      <TextBlock Style="{StaticResource PageSubtitleText}"
                 Text="Every task belongs to a client. Mark internal clients for non-billable work." />
    </StackPanel>

    <!-- Toolbar -->
    <Grid Grid.Row="1" Margin="0,18,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="360" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Grid>
        <TextBox x:Name="SearchBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                 Padding="32,6,8,6" VerticalContentAlignment="Center"
                 AutomationProperties.Name="Filter clients" PreviewKeyDown="OnSearchPreviewKeyDown" />
        <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" Margin="11,0,0,0" IsHitTestVisible="False"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" />
        <TextBlock Text="Filter clients   (Ctrl+F)" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}" />
      </Grid>

      <CheckBox Grid.Column="1" Content="Show inactive" Margin="14,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ShowInactive}" />

      <Button Grid.Column="3" Padding="14,6" Style="{DynamicResource AccentButtonStyle}" Command="{Binding NewClientCommand}"
              ToolTip="New client (Ctrl+N)">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
          <TextBlock Text="New client" />
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="280" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="380" />
      </Grid.ColumnDefinitions>

      <!-- Client list -->
      <Border Style="{StaticResource Card}" Padding="6">
        <Grid>
          <ListBox x:Name="ClientList" Style="{StaticResource RowListBox}"
                   ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                   IsEnabled="{Binding IsListEnabled}" KeyDown="OnListKeyDown"
                   AutomationProperties.Name="Clients">
            <ListBox.InputBindings>
              <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
            </ListBox.InputBindings>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ClientItemViewModel}">
                <Grid x:Name="Row">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <!-- Monogram -->
                  <Border Width="32" Height="32" CornerRadius="16" Margin="0,0,12,0" VerticalAlignment="Center"
                          Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                    <TextBlock x:Name="Monogram" Text="&#xE716;" Style="{StaticResource IconText}" HorizontalAlignment="Center" FontSize="13" />
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Details}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Pill}" Margin="6,0,0,0" Visibility="{Binding IsInternal, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="Internal" Style="{StaticResource PillText}" />
                    </Border>
                    <Border Style="{StaticResource Pill}" Margin="6,0,0,0" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                      <TextBlock Text="Inactive" Style="{StaticResource PillText}" />
                    </Border>
                  </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter TargetName="Row" Property="Opacity" Value="0.6" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsInternal}" Value="True">
                    <Setter TargetName="Monogram" Property="Text" Value="&#xE80F;" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" IsHitTestVisible="False"
                      Visibility="{Binding EmptyMessage, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="&#xE716;" Style="{StaticResource IconText}" FontSize="32" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="{Binding EmptyMessage}" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Editor -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <Grid>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32"
                      Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <TextBlock Text="&#xE70F;" Style="{StaticResource IconText}" FontSize="28" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Select a client to edit it" Margin="0,10,0,0" HorizontalAlignment="Center" />
            <TextBlock Text="or press Ctrl+N to create one" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
          </StackPanel>

          <Grid DataContext="{Binding Editor}"
                Visibility="{Binding DataContext.HasEditor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
            <Grid.InputBindings>
              <KeyBinding Key="Escape" Command="{Binding DataContext.DiscardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </Grid.InputBindings>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="20,16,12,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding Header}" Style="{StaticResource SectionTitleText}" ToolTip="{Binding Header}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <Border Style="{StaticResource Pill}" Margin="0,0,6,0"
                          Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <TextBlock Text="Inactive" Style="{StaticResource PillText}" />
                  </Border>
                  <TextBlock Style="{StaticResource CaptionText}" Text="&#x25CF; Unsaved changes"
                             Foreground="{DynamicResource SystemFillColorCautionBrush}"
                             Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                          Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <Button Style="{StaticResource IconButton}" Content="&#xE9D5;" ToolTip="Show this client's tasks"
                        Command="{Binding DataContext.ShowTasksCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <Button Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                      <Setter Property="Content" Value="&#xE7B8;" />
                      <Setter Property="ToolTip" Value="Deactivate – hide from pickers, keep history" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                          <Setter Property="Content" Value="&#xE7A7;" />
                          <Setter Property="ToolTip" Value="Reactivate" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete (Del)"
                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,0,20,8">
              <StackPanel>
                <TextBlock Text="Name" Style="{StaticResource FieldLabelText}" />
                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                         AutomationProperties.Name="Client name" />
                <TextBlock Text="{Binding NameError}" Style="{StaticResource ErrorText}" />

                <TextBlock Text="Description (optional)" Style="{StaticResource FieldLabelText}" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="72" MaxHeight="200" VerticalScrollBarVisibility="Auto" MaxLength="2000"
                         AutomationProperties.Name="Client description" />
                <TextBlock Text="{Binding DescriptionError}" Style="{StaticResource ErrorText}" />

                <CheckBox Margin="0,16,0,0" IsChecked="{Binding IsInternal}">
                  <StackPanel>
                    <TextBlock Text="Internal client" />
                    <TextBlock Text="Your own organisation: meetings, admin, training." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                  </StackPanel>
                </CheckBox>

                <TextBlock Text="{Binding UsageText}" Style="{StaticResource CaptionText}" Margin="0,18,0,0"
                           Visibility="{Binding UsageText, Converter={StaticResource NullToCollapsed}}" />
              </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="20,12">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="Discard" Padding="14,5" Margin="0,0,8,0" ToolTip="Discard changes (Esc)"
                          Command="{Binding DataContext.DiscardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  <Button Content="Save" Padding="18,5" Style="{DynamicResource AccentButtonStyle}" ToolTip="Save (Ctrl+S)"
                          Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
                <TextBlock Text="Ctrl+S save · Esc discard" Style="{StaticResource CaptionText}" FontSize="11" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
