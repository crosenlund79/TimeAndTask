<Window x:Class="WorkTrace.App.Views.TimeReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkTrace – time registration"
        Width="400" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" ShowActivated="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
    <StackPanel Margin="16,12,16,14">
      <Grid Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image Source="{StaticResource WorkTraceLogo}" Width="22" Height="22" Margin="0,1,10,0" VerticalAlignment="Top"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel Grid.Column="1">
          <TextBlock x:Name="HeadingText" Text="Have you registered your time today?" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Style="{StaticResource CaptionText}">
            <Run Text="WorkTrace" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /><Run Text=" · time registration" />
          </TextBlock>
        </StackPanel>
        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" VerticalAlignment="Top"
                ToolTip="Not yet – remind me later" Click="OnClose" IsTabStop="False" />
      </Grid>

      <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,12,0,14" FontSize="13" />

      <WrapPanel x:Name="PeriodicButtons" HorizontalAlignment="Right">
        <Button Content="Remind me tomorrow" Padding="12,5" Margin="0,0,6,0" Click="OnTomorrow" />
        <Button Content="Not yet" Padding="12,5" Margin="0,0,6,0" Click="OnNotYet" />
        <Button Content="Yes, all done!" Padding="14,5" Style="{DynamicResource AccentButtonStyle}" Click="OnDone" />
      </WrapPanel>
      <WrapPanel x:Name="ShutdownButtons" HorizontalAlignment="Right" Visibility="Collapsed">
        <Button Content="No" Padding="16,5" Margin="0,0,6,0" Click="OnNotYet" />
        <Button Content="Yes" Padding="18,5" Style="{DynamicResource AccentButtonStyle}" Click="OnDone" />
      </WrapPanel>
    </StackPanel>
  </Border>
</Window>
