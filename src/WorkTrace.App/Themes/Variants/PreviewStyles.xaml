<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:WorkTrace.App.Views">

  <!--
    Shared by all visual previews: the keyed styles of Styles.xaml, re-expressed with design tokens
    (corner radii, elevation, typography, selection treatment) that each variant's Theme.xaml defines.
    Same keys and the same structure as production, so views stay unchanged.
  -->

  <views:HexBrushConverter x:Key="HexBrush" />

  <!-- Typography -->
  <Style x:Key="PageTitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource TitleFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource TitleFontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource TitleFontWeight}" />
    <Setter Property="Foreground" Value="{DynamicResource TitleForeground}" />
  </Style>

  <Style x:Key="SectionTitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource SectionFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource SectionFontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource SectionFontWeight}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="BrandText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource BrandFontFamily}" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="{DynamicResource BrandFontWeight}" />
    <Setter Property="Foreground" Value="{DynamicResource BrandForeground}" />
  </Style>

  <Style x:Key="PreviewBadge" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource BadgeBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BadgeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource PillCornerRadius}" />
    <Setter Property="Padding" Value="7,2" />
  </Style>

  <Style x:Key="PreviewBadgeText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="9.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource BadgeForeground}" />
  </Style>

  <!-- Surfaces -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardSurfaceBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
    <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
  </Style>

  <Style x:Key="Pill" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource PillBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PillBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource PillCornerRadius}" />
    <Setter Property="Padding" Value="7,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="SettingsDivider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,8" />
    <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
  </Style>

  <!-- Buttons -->
  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBackground}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBackground}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.3" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SubtleButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBackground}" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBackground}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Lists -->
  <Style x:Key="RowListBoxItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource RowCornerRadius}" Padding="{TemplateBinding Padding}"
                    BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter />
            </Border>
            <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                    Background="{DynamicResource RowIndicatorBrush}" Visibility="Collapsed" Margin="1,0,0,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBackground}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBackground}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource RowSelectedBorderBrush}" />
              <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RowListBox" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource RowListBoxItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.55" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="BoardCardItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,0,0,7" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
          <Border Background="{DynamicResource CardSurfaceBrush}" CornerRadius="{DynamicResource BoardCardCornerRadius}"
                  Effect="{DynamicResource BoardCardEffect}" IsHitTestVisible="False" />
          <Border x:Name="Bd" Background="{DynamicResource CardSurfaceBrush}" CornerRadius="{DynamicResource BoardCardCornerRadius}"
                  BorderThickness="1" BorderBrush="{DynamicResource CardSurfaceBorderBrush}">
            <Border CornerRadius="{DynamicResource BoardCardCornerRadius}"
                    Background="{Binding StakeholderColor, Converter={StaticResource HexBrush}, ConverterParameter=0.10}">
              <Grid>
                <Border Width="3" HorizontalAlignment="Left" CornerRadius="{DynamicResource BoardCardAccentRadius}"
                        Background="{Binding StakeholderColor, Converter={StaticResource HexBrush}}" />
                <ContentPresenter Margin="{TemplateBinding Padding}" />
              </Grid>
            </Border>
          </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding HasDeadlineWarning}" Value="True">
              <Setter TargetName="Bd" Property="BorderThickness" Value="2.5" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Navigation rail entries -->
  <Style x:Key="NavListBoxItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource NavItemForeground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="Glow" CornerRadius="{DynamicResource NavItemCornerRadius}" Background="{DynamicResource NavItemSelectedBackground}"
                    Effect="{DynamicResource NavItemSelectedEffect}" Visibility="Collapsed" IsHitTestVisible="False" />
            <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource NavItemCornerRadius}" Padding="{TemplateBinding Padding}"
                    BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter />
            </Border>
            <Border x:Name="Indicator" Width="{DynamicResource NavIndicatorWidth}" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                    Background="{DynamicResource NavIndicatorBrush}" Visibility="Collapsed" Effect="{DynamicResource NavIndicatorEffect}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavItemHoverBackground}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavItemSelectedBackground}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource NavItemSelectedBorderBrush}" />
              <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource NavItemSelectedForeground}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
