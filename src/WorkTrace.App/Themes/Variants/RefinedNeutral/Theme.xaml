<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Palette.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!--
    WT - Refined Neutral: calm and editorial. Warm ivory paper, cream cards, fine warm-gray rules instead of shadows,
    small 3-4 px rounding, serif page titles (Georgia) over a quiet sans body, olive and sage accents.
  -->

  <!-- Typography: serif display, sans body -->
  <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
  <FontFamily x:Key="TitleFontFamily">Georgia, Cambria, Segoe UI</FontFamily>
  <sys:Double x:Key="TitleFontSize">29</sys:Double>
  <FontWeight x:Key="TitleFontWeight">Normal</FontWeight>
  <SolidColorBrush x:Key="TitleForeground" Color="#2B2721" />
  <FontFamily x:Key="SectionFontFamily">Georgia, Cambria, Segoe UI</FontFamily>
  <sys:Double x:Key="SectionFontSize">17</sys:Double>
  <FontWeight x:Key="SectionFontWeight">Normal</FontWeight>
  <FontFamily x:Key="BrandFontFamily">Georgia, Cambria, Segoe UI</FontFamily>
  <FontWeight x:Key="BrandFontWeight">Normal</FontWeight>
  <SolidColorBrush x:Key="BrandForeground" Color="#3E462C" />

  <!-- Shape: restrained -->
  <CornerRadius x:Key="ControlCornerRadius">3</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="PopupCornerRadius">4</CornerRadius>

  <!-- Shell: linen rail with a fine rule, paper page -->
  <SolidColorBrush x:Key="ShellBackground" Color="#F1EBDF" />
  <SolidColorBrush x:Key="NavRailBackground" Color="#EDE6D8" />
  <SolidColorBrush x:Key="NavRailBorderBrush" Color="#DED4C2" />
  <Thickness x:Key="NavRailBorderThickness">0,0,1,0</Thickness>
  <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#F8F4EC" />
  <CornerRadius x:Key="PageSurfaceCornerRadius">0</CornerRadius>
  <Thickness x:Key="PageSurfaceBorderThickness">0</Thickness>
  <Thickness x:Key="PageSurfaceMargin">0</Thickness>

  <!-- Cards: cream with a fine warm rule, no shadow -->
  <SolidColorBrush x:Key="CardSurfaceBrush" Color="#FFFCF6" />
  <SolidColorBrush x:Key="CardSurfaceBorderBrush" Color="#E3DACA" />
  <Thickness x:Key="CardBorderThickness">1</Thickness>
  <CornerRadius x:Key="CardCornerRadius">4</CornerRadius>
  <Thickness x:Key="CardPadding">20,18</Thickness>
  <CornerRadius x:Key="BoardCardCornerRadius">3</CornerRadius>
  <CornerRadius x:Key="BoardCardAccentRadius">3,0,0,3</CornerRadius>

  <!-- Pills and badge -->
  <SolidColorBrush x:Key="PillBackground" Color="#F3EDE1" />
  <SolidColorBrush x:Key="PillBorderBrush" Color="#E0D6C4" />
  <CornerRadius x:Key="PillCornerRadius">3</CornerRadius>
  <SolidColorBrush x:Key="BadgeBackground" Color="#E8EBDD" />
  <SolidColorBrush x:Key="BadgeBorderBrush" Color="#BFC7A6" />
  <SolidColorBrush x:Key="BadgeForeground" Color="#4F5939" />

  <!-- Lists -->
  <CornerRadius x:Key="RowCornerRadius">3</CornerRadius>
  <SolidColorBrush x:Key="RowHoverBackground" Color="#F2ECE0" />
  <SolidColorBrush x:Key="RowSelectedBackground" Color="#E9EBDD" />
  <SolidColorBrush x:Key="RowSelectedBorderBrush" Color="#D2D8BE" />
  <SolidColorBrush x:Key="RowIndicatorBrush" Color="#6F7D52" />

  <!-- Navigation: sage selection with an olive rule -->
  <SolidColorBrush x:Key="NavItemForeground" Color="#4A4438" />
  <CornerRadius x:Key="NavItemCornerRadius">3</CornerRadius>
  <sys:Double x:Key="NavIndicatorWidth">2</sys:Double>
  <SolidColorBrush x:Key="NavIndicatorBrush" Color="#5F6B45" />
  <SolidColorBrush x:Key="NavItemHoverBackground" Color="#E6DFCF" />
  <SolidColorBrush x:Key="NavItemSelectedBackground" Color="#E0E2D1" />
  <SolidColorBrush x:Key="NavItemSelectedBorderBrush" Color="Transparent" />
  <SolidColorBrush x:Key="NavItemSelectedForeground" Color="#3E462C" />

  <DrawingImage x:Key="WorkTraceLogo">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#5F6B45">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="8,8,240,240" RadiusX="56" RadiusY="56" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Pen>
            <Pen Brush="#FBF7EE" Thickness="22" />
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="128,136" RadiusX="78" RadiusY="78" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M 94,138 L 120,164 L 166,108">
          <GeometryDrawing.Pen>
            <Pen Brush="#FBF7EE" Thickness="24" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#5F6B45">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="128,50" RadiusX="24" RadiusY="24" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#D9B36C">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="128,50" RadiusX="17" RadiusY="17" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>
