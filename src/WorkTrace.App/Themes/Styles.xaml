<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:WorkTrace.App.Views"
                    xmlns:controls="clr-namespace:WorkTrace.App.Controls">

  <!--
    Shared look for WorkTrace (Refined Neutral design). Colours, radii and typography tokens come from Theme.xaml
    (applied over the Fluent theme at start-up by ThemeResources) and are referenced with DynamicResource.
  -->

  <views:NullToCollapsedConverter x:Key="NullToCollapsed" />
  <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <views:InverseBoolConverter x:Key="InverseBool" />
  <views:ThumbnailConverter x:Key="Thumbnail" />
  <views:CountToVisibilityConverter x:Key="CountToVisibility" />
  <views:HexBrushConverter x:Key="HexBrush" />

  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

  <!-- Semantic colours for time classifications (used from Phase 4). -->
  <SolidColorBrush x:Key="ConfirmedBrush" Color="#4E7A3A" />
  <SolidColorBrush x:Key="EstimatedBrush" Color="#A0682A" />
  <SolidColorBrush x:Key="UnclassifiedBrush" Color="#A79F90" />

  <!--
    WorkTrace logo as vector artwork (same geometry as assets/icons/worktrace.svg): crisp at any size and DPI,
    unlike the .ico frames. 256×256 design grid.
  -->
  <DrawingImage x:Key="WorkTraceLogo">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#5F6B45">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="8,8,240,240" RadiusX="56" RadiusY="56" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Pen>
            <Pen Brush="#FBF7EE" Thickness="22" />
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="128,136" RadiusX="78" RadiusY="78" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M 94,138 L 120,164 L 166,108">
          <GeometryDrawing.Pen>
            <Pen Brush="#FBF7EE" Thickness="24" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#5F6B45">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="128,50" RadiusX="24" RadiusY="24" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#D9B36C">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="128,50" RadiusX="17" RadiusY="17" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Typography -->
  <Style x:Key="BrandText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource BrandFontFamily}" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="{DynamicResource BrandFontWeight}" />
    <Setter Property="Foreground" Value="{DynamicResource BrandForeground}" />
  </Style>

  <Style x:Key="PageTitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource TitleFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource TitleFontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource TitleFontWeight}" />
    <Setter Property="Foreground" Value="{DynamicResource TitleForeground}" />
  </Style>

  <Style x:Key="PageSubtitleText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <Style x:Key="SectionTitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource SectionFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource SectionFontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource SectionFontWeight}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="CaptionText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="FieldLabelText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Margin" Value="0,12,0,4" />
  </Style>

  <Style x:Key="ErrorText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="Visibility" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToCollapsed}}" />
  </Style>

  <Style x:Key="IconText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Surfaces -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardSurfaceBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
    <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
  </Style>

  <!-- Small rounded label, e.g. external task IDs and status tags. -->
  <Style x:Key="Pill" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource PillBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PillBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource PillCornerRadius}" />
    <Setter Property="Padding" Value="7,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="PillText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <!--
    Buttons. Standard controls (Button, TextBox, ComboBox, ...) are never restyled here: assigning a
    Style would replace the Fluent theme's implicit style. Only fully templated custom looks follow.
  -->
  <!--
    Small icon-only action; the tooltip carries the meaning (also shown when disabled, to explain why).
    Resting state uses the secondary text colour; hover adds a fill and an outline so the hit area is obvious.
  -->
  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBackground}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBackground}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.3" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Compact labelled action (icon + text) for row-level commands such as Hide/Show. -->
  <Style x:Key="SubtleButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBackground}" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBackground}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text-only link-style button (e.g. "Create client …"). -->
  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <TextBlock x:Name="Text" Text="{TemplateBinding Content}" TextDecorations="{x:Null}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- List rows: rounded selection without the default blue block. -->
  <Style x:Key="RowListBoxItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource RowCornerRadius}" Padding="{TemplateBinding Padding}"
                    BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter />
            </Border>
            <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                    Background="{DynamicResource RowIndicatorBrush}" Visibility="Collapsed" Margin="1,0,0,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBackground}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBackground}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource RowSelectedBorderBrush}" />
              <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RowListBox" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource RowListBoxItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.55" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Board cards: a raised tile per item; selection and keyboard focus use the accent outline. -->
  <Style x:Key="BoardCardItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,0,0,7" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="{DynamicResource CardSurfaceBrush}" CornerRadius="{DynamicResource BoardCardCornerRadius}"
                  BorderThickness="1" BorderBrush="{DynamicResource CardSurfaceBorderBrush}">
            <Border CornerRadius="{DynamicResource BoardCardCornerRadius}"
                    Background="{Binding StakeholderColor, Converter={StaticResource HexBrush}, ConverterParameter=0.10}">
              <Grid>
                <Border Width="3" HorizontalAlignment="Left" CornerRadius="{DynamicResource BoardCardAccentRadius}"
                        Background="{Binding StakeholderColor, Converter={StaticResource HexBrush}}" />
                <ContentPresenter Margin="{TemplateBinding Padding}" />
              </Grid>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding HasDeadlineWarning}" Value="True">
              <Setter TargetName="Bd" Property="BorderThickness" Value="2.5" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Navigation rail entries. -->
  <Style x:Key="NavListBoxItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource NavItemForeground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource NavItemCornerRadius}" Padding="{TemplateBinding Padding}"
                    BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter />
            </Border>
            <Border x:Name="Indicator" Width="{DynamicResource NavIndicatorWidth}" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                    Background="{DynamicResource NavIndicatorBrush}" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavItemHoverBackground}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavItemSelectedBackground}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource NavItemSelectedBorderBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource NavItemSelectedForeground}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Settings row: text on the left, control on the right (Windows Settings layout). -->
  <Style TargetType="controls:SettingRow">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Margin" Value="0,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:SettingRow">
          <Grid MinHeight="40">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
              <TextBlock Text="{TemplateBinding Header}" TextWrapping="Wrap" />
              <TextBlock Text="{TemplateBinding Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None"
                         Visibility="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsDivider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,8" />
    <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
  </Style>

  <!-- Daily task history item (Overview, Timesheet): stakeholder in bold, the task underneath, tinted in the stakeholder colour. -->
  <DataTemplate x:Key="DayTaskTemplate">
    <Border Margin="0,0,6,6" CornerRadius="3" Background="{Binding StakeholderColor, Converter={StaticResource HexBrush}, ConverterParameter=0.10}"
            ToolTip="{Binding Task}">
      <Grid>
        <Border Width="3" HorizontalAlignment="Left" CornerRadius="3,0,0,3" Background="{Binding StakeholderColor, Converter={StaticResource HexBrush}}" />
        <StackPanel Margin="10,3,8,4">
          <TextBlock Text="{Binding Stakeholder}" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Task}" FontSize="12" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>
</ResourceDictionary>
