<Application x:Class="WorkTrace.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             xmlns:views="clr-namespace:WorkTrace.App.Views"
             ThemeMode="System">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Semantic colours for time classifications; shared by later views. -->
      <SolidColorBrush x:Key="ConfirmedBrush" Color="#0F766E" />
      <SolidColorBrush x:Key="EstimatedBrush" Color="#D97706" />
      <SolidColorBrush x:Key="UnclassifiedBrush" Color="#9CA3AF" />
      <SolidColorBrush x:Key="AccentTileBrush" Color="#0F766E" />
      <views:NullToCollapsedConverter x:Key="NullToCollapsed" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
