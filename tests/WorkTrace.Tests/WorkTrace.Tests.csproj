<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>WorkTrace.Tests</RootNamespace>
    <!-- Test method names use underscores for readability. -->
    <NoWarn>$(NoWarn);CA1707;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WorkTrace.Core\WorkTrace.Core.csproj" />
    <ProjectReference Include="..\..\src\WorkTrace.Infrastructure\WorkTrace.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Board/Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
