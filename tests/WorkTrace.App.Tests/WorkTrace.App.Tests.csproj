<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPF smoke and view-model tests. They need the Windows Desktop runtime, so they run on Windows
    (locally and in CI on windows-latest). On other hosts the project still builds but is not run.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>WorkTrace.App.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CA1707;CA2007;WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WorkTrace.App\WorkTrace.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
