<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1848/CA1873: LoggerMessage source generation is not worth the ceremony for this app's low log volume. -->
    <NoWarn>$(NoWarn);CA1848;CA1873</NoWarn>
    <!-- Allows building the WPF project on non-Windows hosts (CI/dev containers). Running still requires Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Company>WorkTrace</Company>
    <Product>WorkTrace</Product>
    <!-- Versioning: Major.Minor here, Patch = CI run number (CI passes -p:Version=0.2.<run>). Local builds are .0.
         The installer gets the same number. Raise Major.Minor here for bigger releases. -->
    <WorkTraceVersionBase>0.2</WorkTraceVersionBase>
    <Version>$(WorkTraceVersionBase).0</Version>
  </PropertyGroup>
</Project>
